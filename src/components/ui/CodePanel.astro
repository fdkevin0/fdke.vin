---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";
import CopyButton from "./CopyButton.astro";

type CodeProps = ComponentProps<typeof Code>;
type CodeLanguage = NonNullable<CodeProps["lang"]>;

interface Props {
	code: string;
	lang?: CodeLanguage;
	title?: string;
	copyValue?: string;
	copyLabel?: string;
	wrap?: boolean;
}

const { code, lang, title, copyValue, copyLabel = "Copy", wrap = true } = Astro.props as Props;
const canCopy = typeof copyValue === "string" && copyValue.length > 0;
const resolvedLang: CodeLanguage = lang ?? "text";
---

<div data-code-copy-root class="border-global-text/20 overflow-hidden rounded border">
	{
		(title || canCopy) && (
			<div class="border-global-text/20 flex items-center justify-between gap-3 border-b px-3 py-2">
				{title ? <p class="text-global-text/75 truncate text-xs">{title}</p> : <span />}
				{canCopy && <CopyButton value={copyValue} label={copyLabel} variant="text" />}
			</div>
		)
	}
	<div class="text-sm">
		<Code code={code} lang={resolvedLang} wrap={wrap} />
	</div>
</div>

<style>
	:global([data-code-copy-root] pre) {
		margin: 0;
		border-radius: 0;
	}

	:global([data-code-copy-root] .astro-code) {
		overflow-x: auto;
		padding: 1rem;
	}
</style>
