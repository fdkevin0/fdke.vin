		&copy; {year}&nbsp;{siteConfig.author}.<span class="inline-block">&nbsp;{siteConfig.title}</span
		>
		<a class="cactus-link ms-2 inline-block" href="/dashboard/">Dashboard</a>
	</div>
</footer>
