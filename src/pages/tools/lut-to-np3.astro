---
import PageLayout from "@/layouts/Base.astro";
---

<PageLayout
	meta={{
		title: "LUT to NP3",
		description:
			"Convert a constrained display-referred 3D .cube LUT into an approximate Nikon Flexible Color NP3 profile.",
	}}
>
	<section class="tool-workbench space-y-8">
		<div class="space-y-4">
			<p class="tool-kicker">
				<a href="/tools/" class="cactus-link">Tools</a> / LUT to NP3
			</p>
			<h1 class="title">LUT to NP3</h1>
			<p class="tool-lede max-w-2xl">
				Convert a constrained 3D <code>.cube</code> LUT into an approximate Nikon Flexible Color
				<code>.NP3</code>. This tool targets display-referred, sRGB-like LUTs and generates an
				editable Nikon starting point rather than an exact equivalent.
			</p>
		</div>

		<div class="block" data-lut-to-np3>
			<div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_20rem]">
				<form class="tool-panel space-y-5" data-tool-form>
					<div class="grid gap-4 sm:grid-cols-2">
						<label class="space-y-2">
							<span class="tool-field-label">LUT File</span>
							<input
								class="tool-input"
								accept=".cube"
								autocomplete="off"
								name="file"
								required
								type="file"
							/>
						</label>
						<label class="space-y-2">
							<span class="tool-field-label">NP3 Name</span>
							<input
								class="tool-input"
								autocomplete="off"
								maxlength="19"
								name="name"
								placeholder="ConvertedLUT…"
								type="text"
							/>
						</label>
					</div>

					<div class="space-y-2">
						<div class="flex items-baseline justify-between gap-3">
							<label class="tool-field-label" for="gray-weight">Gray-Axis Weighting</label>
							<output
								class="text-sm font-semibold text-[var(--tool-teal)] tabular-nums"
								for="gray-weight"
								data-gray-weight-output>0.80</output
							>
						</div>
						<input
							id="gray-weight"
							class="w-full accent-[var(--tool-green)]"
							aria-describedby="gray-weight-help"
							autocomplete="off"
							max="1"
							min="0"
							name="grayWeight"
							step="0.05"
							type="range"
							value="0.8"
						/>
						<p class="tool-note" id="gray-weight-help">
							Higher values push the fit toward neutral-axis tone response. Lower values let the
							converter borrow more average RGB behavior.
						</p>
					</div>

					<div class="tool-status p-3 text-xs leading-relaxed">
						<p class="font-semibold">First Version Constraints</p>
						<p class="mt-2">
							Supported inputs are display-referred 3D <code>.cube</code> LUTs with
							<code>DOMAIN_MIN 0 0 0</code> and <code>DOMAIN_MAX 1 1 1</code>. Log, ACES, HDR, and
							scene-referred LUTs are rejected.
						</p>
					</div>

					<button class="tool-button tool-button-primary" data-convert type="submit">
						Generate NP3
					</button>
				</form>

				<div class="tool-panel space-y-2">
					<p class="tool-field-label">Status</p>
					<div class="tool-status p-3 text-sm" data-status aria-live="polite" role="status">
						Waiting for input.
					</div>
				</div>
			</div>
		</div>
	</section>
</PageLayout>

<script>
	const root = document.querySelector("[data-lut-to-np3]");
	if (root instanceof HTMLElement) {
		const form = root.querySelector("[data-tool-form]");
		const status = root.querySelector("[data-status]");

		if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
			const setStatus = (message: string, isError = false) => {
				status.textContent = message;
				status.classList.toggle("tool-status--danger", isError);
			};

			const fileInput = form.querySelector('input[name="file"]');
			const convertButton = form.querySelector("[data-convert]");

			// A slider with no readout hides the value it is setting.
			const grayWeight = form.querySelector('input[name="grayWeight"]');
			const grayWeightOutput = root.querySelector("[data-gray-weight-output]");
			if (grayWeight instanceof HTMLInputElement && grayWeightOutput instanceof HTMLElement) {
				const syncGrayWeight = () => {
					grayWeightOutput.textContent = Number(grayWeight.value).toFixed(2);
				};
				syncGrayWeight();
				grayWeight.addEventListener("input", syncGrayWeight);
			}

			const setBusy = (busy: boolean) => {
				if (convertButton instanceof HTMLButtonElement) convertButton.disabled = busy;
			};

			form.addEventListener("submit", async (event) => {
				event.preventDefault();
				const file = fileInput instanceof HTMLInputElement ? fileInput.files?.[0] : null;
				if (!file) {
					setStatus("Select a .cube file first.", true);
					return;
				}
				setBusy(true);
				setStatus("Generating NP3…");
				try {
					const response = await fetch("/api/tools/lut-to-np3", {
						body: new FormData(form),
						method: "POST",
					});
					if (!response.ok) {
						const payload = (await response.json().catch(() => ({}))) as { error?: string };
						throw new Error(payload.error || "Conversion failed.");
					}
					const blob = await response.blob();
					const contentDisposition = response.headers.get("Content-Disposition") || "";
					const match = contentDisposition.match(/filename="([^"]+)"/u);
					const filename = decodeURIComponent(match?.[1] || "ConvertedLUT.NP3");
					const url = URL.createObjectURL(blob);
					const anchor = document.createElement("a");
					anchor.href = url;
					anchor.download = filename;
					document.body.appendChild(anchor);
					anchor.click();
					anchor.remove();
					URL.revokeObjectURL(url);
					setStatus(`Generated ${filename}.`);
				} catch (error) {
					setStatus(error instanceof Error ? error.message : "Conversion failed.", true);
				} finally {
					setBusy(false);
				}
			});
		}
	}
</script>
