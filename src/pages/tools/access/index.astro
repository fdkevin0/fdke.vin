---
import { CLOUDFLARE_TEAM_DOMAIN } from "astro:env/server";
import CodePanel from "@/components/ui/CodePanel.astro";
import PageLayout from "@/layouts/Base.astro";

export const prerender = false;

interface AccessIdentity {
	user_uuid?: string;
	ip?: string;
	is_warp?: boolean;
	is_gateway?: boolean;
	device_sessions?: Array<{
		id: string;
		created_at: string;
		expires_at: string;
	}>;
}

const teamDomain = CLOUDFLARE_TEAM_DOMAIN ?? "";
const claims = Astro.locals.accessClaims;
const isLocalBypass = !claims && import.meta.env.DEV;
const error = claims
	? null
	: isLocalBypass
		? "Cloudflare Access is bypassed in local development. Use the dashboard or API endpoints to test authentication."
		: "No verified Access session on this request. Sign in through Cloudflare Access and reload this page.";
let identity: AccessIdentity | null = null;

if (claims) {
	const token =
		Astro.request.headers.get("cf-access-jwt-assertion") ||
		Astro.cookies.get("CF_Authorization")?.value;

	if (token && teamDomain) {
		try {
			const identityResponse = await fetch(`${teamDomain}/cdn-cgi/access/get-identity`, {
				headers: { cookie: `CF_Authorization=${token}` },
				// The identity panel is supplementary; a slow Access endpoint must
				// not hold the whole page open waiting for it.
				signal: AbortSignal.timeout(3000),
			});

			if (identityResponse.ok) {
				const identityData = (await identityResponse.json()) as { data?: AccessIdentity };
				identity = identityData.data ?? null;
			} else {
				console.warn(`[Cloudflare Access] get-identity returned ${identityResponse.status}`);
			}
		} catch (error) {
			// Swallowed silently before, which hid both timeouts and shape changes.
			console.warn("[Cloudflare Access] get-identity failed:", error);
		}
	}
}

const claimsJson = claims ? JSON.stringify(claims, null, 2) : null;
const identityJson = identity ? JSON.stringify(identity, null, 2) : null;
const stampOptions: Intl.DateTimeFormatOptions = {
	dateStyle: "medium",
	timeStyle: "short",
	timeZone: "UTC",
};
let timestampFormat: Intl.DateTimeFormat;
try {
	timestampFormat = new Intl.DateTimeFormat(
		Astro.request.headers.get("accept-language") || undefined,
		stampOptions,
	);
} catch {
	timestampFormat = new Intl.DateTimeFormat(undefined, stampOptions);
}
const formatStamp = (value: string | number) => `${timestampFormat.format(new Date(value))} UTC`;
const expiresAt = claims ? formatStamp(claims.exp * 1000) : null;

const statusRows: { label: string; value: string | null }[] = claims
	? [
			{ label: "Email", value: claims.email },
			{ label: "Name", value: claims.common_name ?? null },
			{ label: "User UUID", value: identity?.user_uuid ?? null },
			{ label: "Country", value: claims.country ?? null },
			{ label: "IP Address", value: identity?.ip ?? null },
			{ label: "Issued", value: formatStamp(claims.iat * 1000) },
			{ label: "Expires", value: expiresAt },
			{ label: "WARP", value: identity?.is_warp ? "Enabled" : null },
			{ label: "Gateway", value: identity?.is_gateway ? "Enabled" : null },
		].filter((row) => row.value)
	: [];
---

<PageLayout
	meta={{
		title: "Cloudflare Access",
		description: "View your Cloudflare Zero Trust authentication status and JWT claims.",
	}}
>
	<section class="tool-workbench space-y-8">
		<div class="space-y-4">
			<p class="tool-kicker">
				<a href="/tools/" class="cactus-link">Tools</a> / Access
			</p>
			<h1 class="title">Cloudflare Access</h1>
			<p class="tool-lede max-w-2xl">Inspect your Cloudflare Access session.</p>
		</div>

		{
			error ? (
				<div
					class:list={["tool-status p-4 text-sm", !isLocalBypass && "tool-status--danger"]}
					role="status"
				>
					<p class="tool-field-label mb-2">
						{isLocalBypass ? "Local Development" : "Not Signed In"}
					</p>
					<p class="leading-relaxed">{error}</p>
				</div>
			) : (
				<div class="space-y-5">
					{statusRows.length > 0 && (
						<div class="tool-panel">
							<div class="tool-panel-head mb-3">
								<h2 class="tool-panel-title">Authentication Status</h2>
								<p class="tool-source">Verified JWT</p>
							</div>
							<dl class="tool-rows">
								{statusRows.map((row) => (
									<div class="tool-row">
										<dt>{row.label}</dt>
										<dd translate="no">{row.value}</dd>
									</div>
								))}
							</dl>
						</div>
					)}

					{identity?.device_sessions && identity.device_sessions.length > 0 && (
						<div class="tool-panel">
							<div class="tool-panel-head mb-3">
								<h2 class="tool-panel-title">Device Sessions</h2>
								<p class="tool-source">Access Identity</p>
							</div>
							<div
								class="focus-visible:outline-accent overflow-x-auto focus-visible:outline-2"
								role="region"
								aria-label="Device sessions"
								tabindex="0"
							>
								<table class="w-full text-sm whitespace-nowrap tabular-nums">
									<thead>
										<tr>
											{["Session ID", "Created", "Expires"].map((label) => (
												<th scope="col" class="text-global-text/75 px-3 py-2 text-left font-medium">
													{label}
												</th>
											))}
										</tr>
									</thead>
									<tbody>
										{identity.device_sessions.map((session) => (
											<tr class="border-t border-[var(--tool-line)]">
												<td class="px-3 py-2" translate="no">
													{session.id}
												</td>
												<td class="px-3 py-2">{formatStamp(session.created_at)}</td>
												<td class="px-3 py-2">{formatStamp(session.expires_at)}</td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
						</div>
					)}

					{claims && (
						<details class="tool-panel">
							<summary class="tool-panel-title cursor-pointer">Raw JWT Claims</summary>
							<div class="mt-4">
								<CodePanel
									title="JWT JSON"
									code={claimsJson || "{}"}
									copyValue={claimsJson || "{}"}
									copyLabel="Copy"
									lang="json"
								/>
							</div>
						</details>
					)}

					{identity && (
						<details class="tool-panel">
							<summary class="tool-panel-title cursor-pointer">Full Identity Payload</summary>
							<div class="mt-4">
								<CodePanel
									title="Identity JSON"
									code={identityJson || "{}"}
									copyValue={identityJson || "{}"}
									copyLabel="Copy"
									lang="json"
								/>
							</div>
						</details>
					)}

					<div class="flex flex-wrap gap-3">
						<a class="tool-button" href={`${teamDomain}/cdn-cgi/access/logout`}>
							Log Out
						</a>
						<a
							class="tool-button"
							href="https://one.dash.cloudflare.com/"
							target="_blank"
							rel="noopener noreferrer"
						>
							Cloudflare One Dashboard
						</a>
					</div>
				</div>
			)
		}
	</section>
</PageLayout>
