---
import { CLOUDFLARE_TEAM_DOMAIN } from "astro:env/server";
import CodePanel from "@/components/ui/CodePanel.astro";
import PageLayout from "@/layouts/Base.astro";

export const prerender = false;

interface AccessIdentity {
	email: string;
	idp?: Record<string, unknown>;
	geo?: string;
	user_uuid?: string;
	devicePosture?: Record<string, unknown>;
	account_id?: string;
	iat?: number;
	ip?: string;
	auth_status?: string;
	common_name?: string;
	service_token_id?: string;
	service_token_status?: boolean;
	is_warp?: boolean;
	is_gateway?: boolean;
	gateway_account_id?: string;
	device_id?: string;
	version?: number;
	device_sessions?: Array<{
		id: string;
		created_at: string;
		expires_at: string;
	}>;
}

const props = await (async () => {
	const teamDomain = CLOUDFLARE_TEAM_DOMAIN ?? "";
	// The middleware already verified this session and kept the claims, so the
	// page reads them instead of running a second jwtVerify — which cost another
	// JWKS lookup on every render of this page.
	const claims = Astro.locals.accessClaims;

	if (!claims) {
		return {
			teamDomain,
			claims: null,
			claimsJson: null,
			identity: null,
			identityJson: null,
			error: import.meta.env.DEV
				? "Cloudflare Access is bypassed in local development. Use the dashboard or API endpoints to test authentication."
				: "No verified Access session on this request. Sign in through Cloudflare Access and reload this page.",
			isLocalBypass: import.meta.env.DEV,
		};
	}

	const token =
		Astro.request.headers.get("cf-access-jwt-assertion") ||
		Astro.cookies.get("CF_Authorization")?.value;

	let identity: AccessIdentity | null = null;

	if (token && teamDomain) {
		try {
			const identityResponse = await fetch(`${teamDomain}/cdn-cgi/access/get-identity`, {
				headers: { cookie: `CF_Authorization=${token}` },
				// The identity panel is supplementary; a slow Access endpoint must
				// not hold the whole page open waiting for it.
				signal: AbortSignal.timeout(3000),
			});

			if (identityResponse.ok) {
				const identityData = (await identityResponse.json()) as { data?: AccessIdentity };
				identity = identityData.data ?? null;
			} else {
				console.warn(`[Cloudflare Access] get-identity returned ${identityResponse.status}`);
			}
		} catch (error) {
			// Swallowed silently before, which hid both timeouts and shape changes.
			console.warn("[Cloudflare Access] get-identity failed:", error);
		}
	}

	return {
		teamDomain,
		claims,
		claimsJson: JSON.stringify(claims, null, 2),
		identity,
		identityJson: identity ? JSON.stringify(identity, null, 2) : null,
		error: null,
		isLocalBypass: false,
	};
})();

// The server cannot know the reader's timezone, so timestamps are stated in UTC
// and labelled, rather than silently rendered in whatever zone the worker runs
// in. The reader's own language still decides the format.
//
// This page is server-rendered per request and the formatter is the costly part
// of that render, so it is built on first use: the not-configured, local-bypass,
// no-token, and verify-failed paths all render without a single timestamp.
let timestampFormat: Intl.DateTimeFormat | null = null;

const formatStamp = (value: string | number) => {
	timestampFormat ??= (() => {
		const options: Intl.DateTimeFormatOptions = {
			dateStyle: "medium",
			timeStyle: "short",
			timeZone: "UTC",
		};
		const readerLocales = (Astro.request.headers.get("accept-language") ?? "")
			.split(",")
			.map((part) => part.split(";")[0]?.trim())
			.filter((tag): tag is string => Boolean(tag) && tag !== "*");
		try {
			return new Intl.DateTimeFormat(readerLocales, options);
		} catch {
			// A malformed Accept-Language must not take the page down.
			return new Intl.DateTimeFormat(undefined, options);
		}
	})();
	return `${timestampFormat.format(new Date(value))} UTC`;
};

// The hero leads with the expiry and the panel repeats it, so it is formatted once.
const expiresAt = props.claims ? formatStamp(props.claims.exp * 1000) : null;

const statusRows: { label: string; value: string | null }[] = props.claims
	? [
			{ label: "Email", value: props.claims.email },
			{ label: "Name", value: props.claims.common_name ?? null },
			{ label: "User UUID", value: props.identity?.user_uuid ?? null },
			{ label: "Country", value: props.claims.country ?? null },
			{ label: "IP Address", value: props.identity?.ip ?? null },
			{ label: "Issued", value: formatStamp(props.claims.iat * 1000) },
			{ label: "Expires", value: expiresAt },
			{ label: "WARP", value: props.identity?.is_warp ? "Enabled" : null },
			{ label: "Gateway", value: props.identity?.is_gateway ? "Enabled" : null },
		].filter((row) => row.value)
	: [];
---

<PageLayout
	meta={{
		title: "Cloudflare Access",
		description: "View your Cloudflare Zero Trust authentication status and JWT claims.",
	}}
>
	<section class="tool-workbench space-y-5">
		<div class="tool-hero space-y-4">
			<p class="tool-kicker">
				<a href="/tools/" class="hover:underline">Tools</a> / Access
			</p>
			<h1 class="tool-title">Cloudflare Access</h1>
			<p class="tool-lede max-w-2xl">
				The Zero Trust session behind this page: who the edge signed in, which device it trusts, and
				when the token runs out.
			</p>
			{
				props.claims && (
					<div class="tool-hero-readout">
						<p class="tool-field-label">Signed In As</p>
						<p class="tool-readout mt-2" translate="no">
							{props.claims.email}
						</p>
						<p class="tool-note mt-2">Token expires {expiresAt}</p>
					</div>
				)
			}
		</div>

		{
			props.error ? (
				<div
					class:list={["tool-status p-4 text-sm", !props.isLocalBypass && "tool-status--danger"]}
					role="status"
				>
					<p class="tool-field-label mb-2">
						{props.isLocalBypass ? "Local Development" : "Not Signed In"}
					</p>
					<p class="leading-relaxed">{props.error}</p>
				</div>
			) : (
				<div class="space-y-5">
					{statusRows.length > 0 && (
						<div class="tool-panel">
							<div class="tool-panel-head mb-3">
								<h2 class="tool-panel-title">Authentication Status</h2>
								<p class="tool-source">Verified JWT</p>
							</div>
							<dl class="tool-rows">
								{statusRows.map((row) => (
									<div class="tool-row">
										<dt>{row.label}</dt>
										<dd translate="no">{row.value}</dd>
									</div>
								))}
							</dl>
						</div>
					)}

					{props.identity?.device_sessions && props.identity.device_sessions.length > 0 && (
						<div class="tool-panel">
							<div class="tool-panel-head mb-3">
								<h2 class="tool-panel-title">Device Sessions</h2>
								<p class="tool-source">Access Identity</p>
							</div>
							<ul class="space-y-4" role="list">
								{props.identity.device_sessions.map((session) => (
									<li class="border-t border-[var(--tool-line)] pt-4 first:border-0 first:pt-0">
										<dl class="tool-rows">
											<div class="tool-row">
												<dt>Session ID</dt>
												<dd translate="no">{session.id}</dd>
											</div>
											<div class="tool-row">
												<dt>Created</dt>
												<dd>{formatStamp(session.created_at)}</dd>
											</div>
											<div class="tool-row">
												<dt>Expires</dt>
												<dd>{formatStamp(session.expires_at)}</dd>
											</div>
										</dl>
									</li>
								))}
							</ul>
						</div>
					)}

					{props.claims && (
						<details class="tool-panel">
							<summary class="tool-panel-title cursor-pointer">Raw JWT Claims</summary>
							<div class="mt-4">
								<CodePanel
									title="JWT JSON"
									code={props.claimsJson || "{}"}
									copyValue={props.claimsJson || "{}"}
									copyLabel="Copy"
									lang="json"
								/>
							</div>
						</details>
					)}

					{props.identity && (
						<details class="tool-panel">
							<summary class="tool-panel-title cursor-pointer">Full Identity Payload</summary>
							<div class="mt-4">
								<CodePanel
									title="Identity JSON"
									code={props.identityJson || "{}"}
									copyValue={props.identityJson || "{}"}
									copyLabel="Copy"
									lang="json"
								/>
							</div>
						</details>
					)}

					<div class="flex flex-wrap gap-3">
						<a class="tool-button" href={`${props.teamDomain}/cdn-cgi/access/logout`}>
							Log Out
						</a>
						<a
							class="tool-button"
							href="https://one.dash.cloudflare.com/"
							target="_blank"
							rel="noopener noreferrer"
						>
							Cloudflare One Dashboard
						</a>
					</div>
				</div>
			)
		}
	</section>
</PageLayout>
