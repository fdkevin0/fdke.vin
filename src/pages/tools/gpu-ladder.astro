</style>

<script>
	import {
		evaluateGpuPerformance,
		evaluateUserSubmission,
		formatGpuShortName,
		formatModelShortName,
		GPU_CATALOG,
		getHardwareTflopsByCapability,
		type GpuSpec,
		type GpuVendor,
		gpuSupportsHardwarePrecision,
		type HardwarePrecision,
		INITIAL_COMMUNITY_SUBMISSIONS,
		inferModelSpecFromRepoId,
		type LadderSortMetric,
		type LlmModelSpec,
		MODEL_CATALOG,
		type Precision,
		parseHuggingFaceConfig,
		parseHuggingFaceModelRef,
		type RealWorldSubmission,
		resolveActualBenchmarkForGpu,
		type TheoreticalEvaluation,
		type WorkloadConfig,
	} from "@/lib/tools/gpu-ladder";

	type DossierTab = "submissions" | "models-matrix" | "hw-specs";

	interface LadderRowItem {
		gpu: GpuSpec;
		theo: TheoreticalEvaluation;
		actual: ReturnType<typeof resolveActualBenchmarkForGpu>;
		totalBandwidthGbs: number;
		totalComputeTflops: number;
		metricValue: number;
	}

	const STORAGE_KEY = "fdkevin:gpu-ladder:submissions:v2";
	const BUILTIN_SUBMISSION_IDS = new Set(INITIAL_COMMUNITY_SUBMISSIONS.map((s) => s.id));
	const GPU_COUNT_OPTIONS = [1, 2, 4, 8, 16] as const;
	const PRECISIONS: readonly Precision[] = ["fp16", "fp8", "int8", "int4"];
	const SORT_METRICS: readonly LadderSortMetric[] = [
		"decodeSingleTps",
		"actualDecodeTps",
		"prefillTps",
		"memBandwidthGbs",
		"computeTflops",
	];
	const VENDORS: readonly GpuVendor[] = ["NVIDIA", "AMD", "Apple", "Huawei", "Intel", "Google"];
	const CAPABILITIES: readonly HardwarePrecision[] = ["fp8", "int4", "bf16", "fp16", "int8"];

	const root = document.querySelector("[data-gpu-ladder]");
	if (root instanceof HTMLElement) {
		const modelSelect = root.querySelector("[data-model-select]") as unknown as HTMLSelectElement;
		const customOption = root.querySelector("[data-custom-option]") as HTMLOptionElement;
		const precisionButtons = Array.from(
			root.querySelectorAll<HTMLButtonElement>("[data-precision]"),
		);
		const gpuCountButtons = Array.from(
			root.querySelectorAll<HTMLButtonElement>("[data-gpu-count]"),
		);

		const workloadSummary = root.querySelector("[data-workload-summary]") as HTMLElement;
		const customizeToggle = root.querySelector("[data-customize-toggle]") as HTMLButtonElement;
		const customizePanel = root.querySelector("[data-customize-panel]") as HTMLElement;

		const hfInput = root.querySelector("[data-hf-input]") as HTMLInputElement;
		const hfFetchBtn = root.querySelector("[data-hf-fetch]") as HTMLButtonElement;
		const hfStatus = root.querySelector("[data-hf-status]") as HTMLElement;
		const paramTotalInput = root.querySelector("[data-param-total]") as HTMLInputElement;
		const paramActiveInput = root.querySelector("[data-param-active]") as HTMLInputElement;
		const inputTokensInput = root.querySelector("[data-input-tokens]") as HTMLInputElement;
		const outputTokensInput = root.querySelector("[data-output-tokens]") as HTMLInputElement;
		const batchSizeInput = root.querySelector("[data-batch-size]") as HTMLInputElement;

		const sortButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-sort-metric]"));
		const gpuSearchInput = root.querySelector("[data-gpu-search]") as HTMLInputElement;
		const filterToggle = root.querySelector("[data-filter-toggle]") as HTMLButtonElement;
		const filterPanel = root.querySelector("[data-filter-panel]") as HTMLElement;
		const vendorButtons = Array.from(
			root.querySelectorAll<HTMLButtonElement>("[data-vendor-filter]"),
		);
		const capButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-cap-filter]"));
		const hideOomCheckbox = root.querySelector("[data-hide-oom]") as HTMLInputElement;
		const filterResetBtn = root.querySelector("[data-filter-reset]") as HTMLButtonElement;

		const resultCountEl = root.querySelector("[data-result-count]") as HTMLElement;
		const barLegendEl = root.querySelector("[data-bar-legend]") as HTMLElement;
		const ladderRegion = root.querySelector("[data-ladder-region]") as HTMLElement;

		const defaultModel = MODEL_CATALOG.find((m) => m.id === "qwen3-32b") ?? MODEL_CATALOG[0];
		if (!defaultModel) {
			throw new Error("MODEL_CATALOG must not be empty.");
		}

		let currentModel: LlmModelSpec = { ...defaultModel };
		let weightPrecision: Precision = "int4";
		let gpuCount = 1;
		let sortMetric: LadderSortMetric = "decodeSingleTps";
		let vendorFilter: GpuVendor | "all" = "all";
		let capabilityFilter: HardwarePrecision | "all" = "all";
		let expandedGpuId: string | null = null;
		let activeDossierTab: DossierTab = "submissions";
		let logFormOpen = false;
		let draftDecodeValue = "";
		let draftPrefillValue = "";
		let draftEngineValue = "";
		let draftNotesValue = "";
		let draftGpuCount: number | null = null;

		const el = <K extends keyof HTMLElementTagNameMap>(
			tag: K,
			className?: string,
			text?: string,
		): HTMLElementTagNameMap[K] => {
			const node = document.createElement(tag);
			if (className) node.className = className;
			if (text !== undefined) node.textContent = text;
			return node;
		};

		const append = (parent: Node, ...children: Node[]) => {
			for (const child of children) {
				parent.appendChild(child);
			}
		};

		const createChevronSvg = (): SVGSVGElement => {
			const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
			svg.setAttribute("aria-hidden", "true");
			svg.setAttribute("class", "gl-chevron");
			svg.setAttribute("viewBox", "0 0 12 12");
			svg.setAttribute("fill", "none");
			svg.setAttribute("stroke", "currentColor");
			svg.setAttribute("stroke-width", "1.5");
			const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
			path.setAttribute("d", "M3 4.5L6 7.5L9 4.5");
			path.setAttribute("stroke-linecap", "round");
			path.setAttribute("stroke-linejoin", "round");
			svg.appendChild(path);
			return svg;
		};

		const createExternalLink = (label: string, href: string, className = "cactus-link") => {
			const link = el("a", className, `${label} ↗`);
			link.href = href;
			link.target = "_blank";
			link.rel = "noopener noreferrer";
			return link;
		};

		const loadUserSubmissions = (): RealWorldSubmission[] => {
			try {
				const raw = localStorage.getItem(STORAGE_KEY);
				if (!raw) return [];
				const parsed = JSON.parse(raw) as RealWorldSubmission[];
				if (!Array.isArray(parsed)) return [];
				return parsed.filter((item) => item && !BUILTIN_SUBMISSION_IDS.has(item.id));
			} catch {
				return [];
			}
		};

		const saveUserSubmissions = (customEntries: RealWorldSubmission[]) => {
			try {
				if (customEntries.length === 0) {
					localStorage.removeItem(STORAGE_KEY);
				} else {
					localStorage.setItem(STORAGE_KEY, JSON.stringify(customEntries));
				}
			} catch {
				// Ignore storage quota errors
			}
		};

		const readWorkload = (overrideGpuCount?: number): WorkloadConfig => ({
			gpuCount: overrideGpuCount ?? gpuCount,
			weightPrecision,
			kvPrecision: weightPrecision === "fp16" ? "fp16" : "fp8",
			inputTokens: Math.max(16, Number(inputTokensInput.value) || 2048),
			outputTokens: Math.max(16, Number(outputTokensInput.value) || 512),
			batchSize: Math.max(1, Number(batchSizeInput.value) || 1),
		});

		const syncControlsUi = () => {
			for (const btn of precisionButtons) {
				btn.setAttribute("aria-checked", String(btn.dataset.precision === weightPrecision));
			}
			for (const btn of gpuCountButtons) {
				btn.setAttribute("aria-checked", String(Number(btn.dataset.gpuCount) === gpuCount));
			}
			for (const btn of sortButtons) {
				btn.setAttribute("aria-selected", String(btn.dataset.sortMetric === sortMetric));
			}
			for (const btn of vendorButtons) {
				btn.setAttribute("aria-pressed", String(btn.dataset.vendorFilter === vendorFilter));
			}
			for (const btn of capButtons) {
				btn.setAttribute("aria-pressed", String(btn.dataset.capFilter === capabilityFilter));
			}

			const activeFilterCount =
				(vendorFilter !== "all" ? 1 : 0) +
				(capabilityFilter !== "all" ? 1 : 0) +
				(hideOomCheckbox.checked ? 1 : 0);

			filterToggle.textContent = activeFilterCount > 0 ? `Filter · ${activeFilterCount}` : "Filter";
			filterToggle.dataset.active = String(activeFilterCount > 0);

			const hasAnyFilter = activeFilterCount > 0 || gpuSearchInput.value.trim().length > 0;
			filterResetBtn.classList.toggle("hidden", !hasAnyFilter);

			customOption.textContent =
				currentModel.id === "custom" || currentModel.id.startsWith("hf:")
					? `Custom · ${formatModelShortName(currentModel)}`
					: "Custom / HuggingFace repo…";
		};

		const syncUrlState = () => {
			const params = new URLSearchParams();
			if (currentModel.id !== "qwen3-32b" && MODEL_CATALOG.some((m) => m.id === currentModel.id)) {
				params.set("model", currentModel.id);
			}
			if (weightPrecision !== "int4") params.set("q", weightPrecision);
			if (gpuCount !== 1) params.set("n", String(gpuCount));
			if (sortMetric !== "decodeSingleTps") params.set("sort", sortMetric);
			if (vendorFilter !== "all") params.set("vendor", vendorFilter);
			if (capabilityFilter !== "all") params.set("cap", capabilityFilter);
			if (hideOomCheckbox.checked) params.set("fit", "1");
			if (expandedGpuId) params.set("gpu", expandedGpuId);

			const query = params.toString();
			const nextUrl = query ? `${window.location.pathname}?${query}` : window.location.pathname;
			window.history.replaceState(null, "", nextUrl);
		};

		const hydrateFromUrl = () => {
			const params = new URLSearchParams(window.location.search);
			const modelParam = params.get("model");
			const foundModel = MODEL_CATALOG.find((m) => m.id === modelParam);
			if (foundModel) {
				currentModel = { ...foundModel };
				modelSelect.value = foundModel.id;
			}

			const qParam = params.get("q") as Precision | null;
			if (qParam && PRECISIONS.includes(qParam)) {
				weightPrecision = qParam;
			}

			const nParam = Number(params.get("n"));
			if (GPU_COUNT_OPTIONS.includes(nParam as (typeof GPU_COUNT_OPTIONS)[number])) {
				gpuCount = nParam;
			}

			const sortParam = params.get("sort") as LadderSortMetric | null;
			if (sortParam && SORT_METRICS.includes(sortParam)) {
				sortMetric = sortParam;
			}

			const vendorParam = params.get("vendor") as GpuVendor | null;
			if (vendorParam && VENDORS.includes(vendorParam)) {
				vendorFilter = vendorParam;
			}

			const capParam = params.get("cap") as HardwarePrecision | null;
			if (capParam && CAPABILITIES.includes(capParam)) {
				capabilityFilter = capParam;
			}

			if (params.get("fit") === "1") {
				hideOomCheckbox.checked = true;
			}

			const gpuParam = params.get("gpu");
			if (gpuParam && GPU_CATALOG.some((g) => g.id === gpuParam)) {
				expandedGpuId = gpuParam;
			}
		};

		const syncSummaryLine = (workload: WorkloadConfig) => {
			const refGpu = GPU_CATALOG[0];
			const requiredGb = refGpu
				? evaluateGpuPerformance(refGpu, currentModel, workload).totalVramGb
				: 0;
			if (document.activeElement !== paramTotalInput) {
				paramTotalInput.value = String(currentModel.totalParamsB);
			}
			if (document.activeElement !== paramActiveInput) {
				paramActiveInput.value = String(currentModel.activeParamsB);
			}

			const archSummary =
				currentModel.architecture === "moe"
					? `${currentModel.totalParamsB}B (${currentModel.activeParamsB}B active) MoE`
					: `${currentModel.totalParamsB}B dense`;
			const batchPart = workload.batchSize > 1 ? ` · batch ${workload.batchSize}` : "";
			workloadSummary.textContent = `${archSummary} · ${requiredGb.toFixed(1)} GB · ${workload.inputTokens.toLocaleString()}→${workload.outputTokens.toLocaleString()} tok${batchPart}`;
		};

		const formatDenseComputeSummary = (gpu: GpuSpec): string => {
			const parts = [`FP16 ${gpu.fp16Tflops.toLocaleString()}`];
			if (gpu.bf16Tflops) parts.push(`BF16 ${gpu.bf16Tflops.toLocaleString()}`);
			if (gpu.fp8Tflops) parts.push(`FP8 ${gpu.fp8Tflops.toLocaleString()}`);
			if (gpu.int8Tflops) parts.push(`INT8 ${gpu.int8Tflops.toLocaleString()}`);
			if (gpu.int4Tflops) parts.push(`INT4 ${gpu.int4Tflops.toLocaleString()}`);
			return `${parts.join(" · ")} TFLOPS`;
		};

		const appendDlRow = (dl: HTMLElement, label: string, content: string | Node) => {
			const row = el("div");
			const dt = el("dt", undefined, label);
			const dd = el("dd");
			if (typeof content === "string") {
				dd.textContent = content;
			} else {
				dd.appendChild(content);
			}
			append(row, dt, dd);
			dl.appendChild(row);
		};

		const buildTelemetryStrip = (
			theo: TheoreticalEvaluation,
			actual: ReturnType<typeof resolveActualBenchmarkForGpu>,
		): HTMLElement => {
			const strip = el("div", "gl-telemetry");
			const isOom = theo.vramStatus === "oom";

			// 1. Decode ceiling
			const cDecode = el("div", "gl-telemetry-cell");
			append(
				cDecode,
				el("div", "gl-k-label", "Decode ceiling"),
				el(
					"div",
					"gl-k-val",
					isOom ? "Insufficient VRAM" : `${theo.decodeSingleTps.toFixed(1)} tok/s`,
				),
				el(
					"div",
					"gl-k-sub",
					isOom
						? `Needs ${theo.totalVramGb.toFixed(1)} GB`
						: `${theo.tpotMs.toFixed(2)} ms/tok · ${theo.bottleneck === "compute" ? "compute-bound" : "memory-bound"}`,
				),
			);

			// 2. Prefill ceiling
			const cPrefill = el("div", "gl-telemetry-cell");
			append(
				cPrefill,
				el("div", "gl-k-label", "Prefill ceiling"),
				el(
					"div",
					"gl-k-val",
					isOom ? "—" : `${Math.round(theo.prefillTps).toLocaleString()} tok/s`,
				),
				el(
					"div",
					"gl-k-sub",
					isOom
						? `${Math.round(theo.prefillTps).toLocaleString()} tok/s compute`
						: `TTFT ${theo.ttftMs.toFixed(0)} ms`,
				),
			);

			// 3. Memory + miniature breakdown bar
			const cMem = el("div", "gl-telemetry-cell");
			const vramTotalScale = Math.max(theo.availableVramGb, theo.totalVramGb, 1);
			const memBar = el("div", "gl-vram-bar");
			const wtSeg = el("div", "gl-vram-wt");
			wtSeg.style.width = `${(theo.weightsVramGb / vramTotalScale) * 100}%`;
			const kvSeg = el("div", "gl-vram-kv");
			kvSeg.style.width = `${(theo.kvCacheVramGb / vramTotalScale) * 100}%`;
			const sysSeg = el("div", "gl-vram-sys");
			sysSeg.style.width = `${(theo.overheadVramGb / vramTotalScale) * 100}%`;
			append(memBar, wtSeg, kvSeg, sysSeg);

			append(
				cMem,
				el("div", "gl-k-label", "Memory"),
				el("div", "gl-k-val", `${theo.totalVramGb.toFixed(1)} / ${theo.availableVramGb} GB`),
				memBar,
				el(
					"div",
					"gl-k-sub",
					`${theo.vramUtilizationPct}% (${theo.weightsVramGb}G wt · ${theo.kvCacheVramGb}G kv)`,
				),
			);

			// 4. Empirical
			const cActual = el("div", "gl-telemetry-cell");
			append(
				cActual,
				el("div", "gl-k-label", "Empirical"),
				el(
					"div",
					"gl-k-val",
					actual.actualDecodeTps != null
						? `${actual.actualDecodeTps.toFixed(1)} tok/s`
						: "Unmeasured",
				),
				el(
					"div",
					"gl-k-sub",
					actual.actualDecodeTps != null
						? `${actual.mbuPct}% MBU · ${actual.isDirectMatch ? "verified" : "projected"}`
						: "No benchmark logged",
				),
			);

			append(strip, cDecode, cPrefill, cMem, cActual);
			return strip;
		};

		const buildSubmissionsPanel = (
			gpu: GpuSpec,
			theo: TheoreticalEvaluation,
			workload: WorkloadConfig,
			gpuSubs: RealWorldSubmission[],
		): HTMLElement => {
			const panel = el("div");

			if (logFormOpen) {
				const form = el("form", "gl-log-form space-y-3");
				const grid = el("div", "grid grid-cols-2 gap-2.5 sm:grid-cols-4");

				const countLabel = el("label", "gl-field");
				countLabel.appendChild(el("span", undefined, "GPUs"));
				const countSel = el("select", "gl-select");
				const activeSubCount = draftGpuCount ?? workload.gpuCount;
				for (const n of GPU_COUNT_OPTIONS) {
					const opt = new Option(`${n}×`, String(n), false, n === activeSubCount);
					countSel.appendChild(opt);
				}
				countLabel.appendChild(countSel);

				const decodeLabel = el("label", "gl-field");
				decodeLabel.appendChild(el("span", undefined, "Decode (tok/s)"));
				const decodeInput = el("input", "gl-input tabular-nums");
				decodeInput.type = "number";
				decodeInput.min = "0.1";
				decodeInput.step = "0.1";
				decodeInput.required = true;
				decodeInput.value = draftDecodeValue;
				decodeInput.placeholder =
					theo.vramStatus === "oom" ? "40.0" : (theo.decodeSingleTps * 0.78).toFixed(1);
				decodeLabel.appendChild(decodeInput);

				const prefillLabel = el("label", "gl-field");
				prefillLabel.appendChild(el("span", undefined, "Prefill (tok/s)"));
				const prefillInput = el("input", "gl-input tabular-nums");
				prefillInput.type = "number";
				prefillInput.min = "1";
				prefillInput.step = "1";
				prefillInput.value = draftPrefillValue;
				prefillInput.placeholder =
					theo.vramStatus === "oom" ? "5000" : String(Math.round(theo.prefillTps * 0.72));
				prefillLabel.appendChild(prefillInput);

				const engineLabel = el("label", "gl-field");
				engineLabel.appendChild(el("span", undefined, "Engine"));
				const engineInput = el("input", "gl-input");
				engineInput.type = "text";
				engineInput.required = true;
				engineInput.value = draftEngineValue;
				engineInput.placeholder = "vLLM, SGLang, llama.cpp…";
				engineLabel.appendChild(engineInput);

				append(grid, countLabel, decodeLabel, prefillLabel, engineLabel);

				const bottomRow = el("div", "flex flex-wrap items-end gap-2.5");
				const notesLabel = el("label", "gl-field min-w-0 flex-1");
				notesLabel.appendChild(el("span", undefined, "Notes"));
				const notesInput = el("input", "gl-input");
				notesInput.type = "text";
				notesInput.value = draftNotesValue;
				notesInput.placeholder = "Kernel, quant, or interconnect notes";
				notesLabel.appendChild(notesInput);

				const saveBtn = el("button", "gl-btn-subtle shrink-0", "Save locally");
				saveBtn.type = "submit";
				append(bottomRow, notesLabel, saveBtn);

				const liveDiag = el("p", "gl-muted-text text-[11px] tabular-nums");

				const refreshLiveDiag = () => {
					const dec = Number(decodeInput.value);
					const pf = Number(prefillInput.value);
					if (!(dec > 0 || pf > 0)) {
						liveDiag.textContent =
							"Enter measured tok/s to compute MBU and MFU against Roofline limits.";
						return;
					}
					const subCount = Math.max(1, Number(countSel.value) || 1);
					const formTheo = evaluateGpuPerformance(gpu, currentModel, {
						...workload,
						gpuCount: subCount,
					});
					const report = evaluateUserSubmission(formTheo, pf > 0 ? pf : 0, dec > 0 ? dec : 0);
					const mfuPart = pf > 0 ? `${report.mfuPct}%` : "—";
					liveDiag.textContent = `MBU ${report.mbuPct}% · MFU ${mfuPart} · ${report.decodeCeilingPct}% of ceiling — ${report.tierLabel}`;
				};

				countSel.addEventListener("change", () => {
					draftGpuCount = Number(countSel.value) || 1;
					refreshLiveDiag();
				});
				decodeInput.addEventListener("input", () => {
					draftDecodeValue = decodeInput.value;
					refreshLiveDiag();
				});
				prefillInput.addEventListener("input", () => {
					draftPrefillValue = prefillInput.value;
					refreshLiveDiag();
				});
				engineInput.addEventListener("input", () => {
					draftEngineValue = engineInput.value;
				});
				notesInput.addEventListener("input", () => {
					draftNotesValue = notesInput.value;
				});

				form.addEventListener("submit", (event) => {
					event.preventDefault();
					const actualDecode = Number(decodeInput.value);
					if (!(actualDecode > 0)) return;
					const actualPrefill = Math.max(1, Number(prefillInput.value) || 1);
					const subCount = Math.max(1, Number(countSel.value) || 1);

					const newEntry: RealWorldSubmission = {
						id: `user-${Date.now()}`,
						gpuId: gpu.id,
						gpuCount: subCount,
						modelId: currentModel.id,
						modelName: formatModelShortName(currentModel),
						weightPrecision: workload.weightPrecision,
						kvPrecision: workload.kvPrecision,
						engine: engineInput.value.trim() || "Custom runtime",
						inputTokens: workload.inputTokens,
						outputTokens: workload.outputTokens,
						batchSize: workload.batchSize,
						actualPrefillTps: actualPrefill,
						actualDecodeSingleTps: actualDecode,
						submitter: "local",
						notes: notesInput.value.trim() || "Local benchmark entry",
						createdAt: new Date().toISOString().slice(0, 10),
					};

					saveUserSubmissions([newEntry, ...loadUserSubmissions()]);
					draftDecodeValue = "";
					draftPrefillValue = "";
					draftEngineValue = "";
					draftNotesValue = "";
					draftGpuCount = null;
					logFormOpen = false;
					render();
				});

				refreshLiveDiag();
				append(form, grid, bottomRow, liveDiag);
				panel.appendChild(form);
			}

			if (gpuSubs.length === 0) {
				const empty = el("div", "mt-3 flex flex-wrap items-center gap-2 text-xs");
				empty.appendChild(
					el("span", "gl-muted-text", "No empirical runs recorded for this accelerator yet."),
				);
				if (!logFormOpen) {
					const openBtn = el("button", "gl-link-btn", "Log a measurement");
					openBtn.type = "button";
					openBtn.addEventListener("click", () => {
						logFormOpen = true;
						render();
					});
					empty.appendChild(openBtn);
				}
				panel.appendChild(empty);
				return panel;
			}

			const list = el("div", "gl-bench-list");
			for (const sub of gpuSubs) {
				const mSpec =
					MODEL_CATALOG.find((m) => m.id === sub.modelId) ??
					inferModelSpecFromRepoId(sub.modelName) ??
					currentModel;
				const subTheo = evaluateGpuPerformance(gpu, mSpec, {
					gpuCount: sub.gpuCount,
					weightPrecision: sub.weightPrecision,
					kvPrecision: sub.kvPrecision,
					inputTokens: sub.inputTokens,
					outputTokens: sub.outputTokens,
					batchSize: sub.batchSize,
				});
				const rep = evaluateUserSubmission(
					subTheo,
					sub.actualPrefillTps,
					sub.actualDecodeSingleTps,
				);

				const row = el("div", "gl-bench-row");

				// Left column: engine, model & notes
				const main = el("div", "gl-bench-main");
				const engLine = el("div", "font-medium text-[var(--gl-ink)] text-xs");
				const engTitle = `${sub.gpuCount}× · ${sub.engine}`;
				if (sub.sourceUrl) {
					engLine.appendChild(createExternalLink(engTitle, sub.sourceUrl));
				} else {
					engLine.textContent = engTitle;
				}
				const modName = sub.modelName.replace(/\s*\([^)]*\)\s*$/u, "").trim();
				const modLine = el(
					"div",
					"gl-muted-text text-[11px] tabular-nums mt-0.5",
					`${modName} · ${sub.weightPrecision.toUpperCase()} / KV ${sub.kvPrecision.toUpperCase()} · ${sub.inputTokens}→${sub.outputTokens}`,
				);
				main.appendChild(engLine);
				main.appendChild(modLine);
				if (sub.notes.trim()) {
					main.appendChild(el("div", "gl-muted-text text-[11px] mt-0.5", sub.notes));
				}

				// Right column: decode ceiling & efficiency + optional delete
				const right = el("div", "gl-bench-right");
				const stats = el("div");
				const decLine = el("div", "text-xs");
				decLine.appendChild(
					el(
						"span",
						"font-semibold text-[var(--gl-ink)]",
						`${sub.actualDecodeSingleTps.toFixed(1)} tok/s`,
					),
				);
				decLine.appendChild(
					el(
						"span",
						"gl-muted-text text-[11px]",
						` (${rep.decodeCeilingPct}% of ${subTheo.decodeSingleTps.toFixed(1)})`,
					),
				);
				const effLine = el(
					"div",
					"gl-muted-text text-[11px] mt-0.5",
					`MBU ${rep.mbuPct}% · MFU ${rep.mfuPct}% · ${rep.tierLabel}`,
				);
				append(stats, decLine, effLine);
				right.appendChild(stats);

				if (!BUILTIN_SUBMISSION_IDS.has(sub.id)) {
					const rmBtn = el("button", "gl-remove-btn", "×");
					rmBtn.type = "button";
					rmBtn.setAttribute("aria-label", "Remove benchmark");
					rmBtn.addEventListener("click", () => {
						const remaining = loadUserSubmissions().filter((item) => item.id !== sub.id);
						saveUserSubmissions(remaining);
						render();
					});
					right.appendChild(rmBtn);
				}

				append(row, main, right);
				list.appendChild(row);
			}

			panel.appendChild(list);
			return panel;
		};

		const buildModelsMatrixPanel = (gpu: GpuSpec, workload: WorkloadConfig): HTMLElement => {
			const wrap = el("div", "gl-table-wrap");
			const table = el("table", "gl-table");
			const thead = el("thead");
			const hRow = el("tr");
			for (const [title, align] of [
				["Model", "text-left"],
				["Params", "text-left"],
				["VRAM", "text-right"],
				["Prefill", "text-right"],
				["Decode", "text-right"],
			] as const) {
				hRow.appendChild(el("th", align, title));
			}
			thead.appendChild(hRow);

			const tbody = el("tbody");
			for (const model of MODEL_CATALOG) {
				const ev = evaluateGpuPerformance(gpu, model, workload);
				const isOom = ev.vramStatus === "oom";
				const tr = el("tr", isOom ? "opacity-55" : undefined);

				const tdName = el("td");
				tdName.appendChild(
					createExternalLink(
						formatModelShortName(model),
						`https://huggingface.co/${model.hfRepoId}`,
						"cactus-link font-medium",
					),
				);

				const tdParams = el(
					"td",
					"gl-muted-text tabular-nums whitespace-nowrap",
					model.architecture === "moe"
						? `${model.totalParamsB}B / ${model.activeParamsB}B`
						: `${model.totalParamsB}B`,
				);

				const tdVram = el(
					"td",
					"text-right tabular-nums whitespace-nowrap",
					`${ev.totalVramGb.toFixed(1)} / ${ev.availableVramGb} GB`,
				);

				const tdPrefill = el(
					"td",
					"text-right tabular-nums whitespace-nowrap",
					isOom ? "—" : `${Math.round(ev.prefillTps).toLocaleString()} tok/s`,
				);

				const tdDecode = el(
					"td",
					`text-right tabular-nums whitespace-nowrap ${isOom ? "gl-muted-text" : "font-semibold text-[var(--gl-ink)]"}`,
					isOom
						? `Short ${(ev.totalVramGb - ev.availableVramGb).toFixed(1)} GB`
						: `${ev.decodeSingleTps.toFixed(1)} tok/s`,
				);

				append(tr, tdName, tdParams, tdVram, tdPrefill, tdDecode);
				tbody.appendChild(tr);
			}

			append(table, thead, tbody);
			wrap.appendChild(table);
			return wrap;
		};

		const buildHardwarePanel = (
			gpu: GpuSpec,
			theo: TheoreticalEvaluation,
			workload: WorkloadConfig,
		): HTMLElement => {
			const container = el("div", "gl-dl");

			const left = el("div");
			left.appendChild(el("h3", "gl-dl-section-title", "Specifications"));
			const dlSpec = el("dl", "gl-dl-list");
			appendDlRow(dlSpec, "Architecture", `${gpu.vendor} ${gpu.architecture} (${gpu.releaseYear})`);
			appendDlRow(
				dlSpec,
				"Memory",
				`${gpu.vramGb} GB · ${gpu.memBandwidthGbs.toLocaleString()} GB/s`,
			);
			appendDlRow(dlSpec, "Dense compute", formatDenseComputeSummary(gpu));
			appendDlRow(dlSpec, "Vector FP32", `${gpu.fp32Tflops.toLocaleString()} TFLOPS`);
			appendDlRow(
				dlSpec,
				"Interconnect",
				`${gpu.interconnect.toUpperCase()} · ${gpu.interconnectBandwidthGbs.toLocaleString()} GB/s`,
			);
			appendDlRow(dlSpec, "Power", `${gpu.tdpWatts} W TDP`);
			appendDlRow(dlSpec, "Spec source", createExternalLink(gpu.sourceName, gpu.sourceUrl));
			left.appendChild(dlSpec);

			const right = el("div");
			right.appendChild(el("h3", "gl-dl-section-title", "Roofline math"));
			const dlMath = el("dl", "gl-dl-list");
			const clusterPrefix = workload.gpuCount > 1 ? `${workload.gpuCount}× · ` : "";
			appendDlRow(
				dlMath,
				"Active workload",
				createExternalLink(
					`${clusterPrefix}${formatModelShortName(currentModel)} · ${workload.weightPrecision.toUpperCase()}`,
					`https://huggingface.co/${currentModel.hfRepoId}`,
				),
			);
			appendDlRow(
				dlMath,
				"VRAM breakdown",
				`${theo.weightsVramGb}G wt + ${theo.kvCacheVramGb}G kv + ${theo.overheadVramGb}G sys`,
			);
			appendDlRow(
				dlMath,
				"Decode traffic",
				`${(theo.decodeBytesPerStep / 1e9).toFixed(2)} GB / token`,
			);
			appendDlRow(dlMath, "Ridge point", `${theo.ridgePointOpsPerByte} ops/byte`);
			appendDlRow(dlMath, "Decode intensity", `${theo.decodeArithmeticIntensity} ops/byte`);
			appendDlRow(
				dlMath,
				"Multi-GPU scaling",
				`${Math.round(theo.multiGpuBandwidthEfficiency * 100)}% BW · ${Math.round(theo.multiGpuComputeEfficiency * 100)}% FLOPs`,
			);
			appendDlRow(
				dlMath,
				"E2E latency",
				theo.vramStatus === "oom"
					? "—"
					: `${theo.endToEndLatencySec}s (${workload.outputTokens} tok)`,
			);
			appendDlRow(dlMath, "Calibration", gpu.calibrationNote);
			right.appendChild(dlMath);

			append(container, left, right);
			return container;
		};

		const buildDossier = (
			item: LadderRowItem,
			workload: WorkloadConfig,
			submissions: RealWorldSubmission[],
			userSubs: RealWorldSubmission[],
		): HTMLElement => {
			const { gpu, theo, actual } = item;
			const gpuSubs = submissions.filter((s) => s.gpuId === gpu.id);
			const dossier = el("div", "gl-dossier");

			dossier.appendChild(buildTelemetryStrip(theo, actual));

			// Sub-tabs bar
			const nav = el("div", "gl-dossier-nav");
			const tabsWrap = el("div", "gl-dossier-tabs");
			tabsWrap.setAttribute("role", "tablist");

			const tabs: Array<{ id: DossierTab; label: string }> = [
				{ id: "submissions", label: `Benchmarks (${gpuSubs.length})` },
				{ id: "models-matrix", label: "All models" },
				{ id: "hw-specs", label: "Hardware" },
			];

			for (const t of tabs) {
				const btn = el("button", "gl-axis-tab", t.label);
				btn.type = "button";
				btn.setAttribute("role", "tab");
				btn.setAttribute("aria-selected", String(activeDossierTab === t.id));
				btn.dataset.focusId = `tab:${t.id}`;
				btn.addEventListener("click", () => {
					activeDossierTab = t.id;
					render();
				});
				tabsWrap.appendChild(btn);
			}
			nav.appendChild(tabsWrap);

			if (activeDossierTab === "submissions") {
				const actions = el("div", "gl-dossier-actions");
				const toggleLog = el("button", "gl-link-btn", "+ Log run");
				toggleLog.type = "button";
				toggleLog.setAttribute("aria-expanded", String(logFormOpen));
				toggleLog.dataset.focusId = "toggle-log";
				toggleLog.addEventListener("click", () => {
					logFormOpen = !logFormOpen;
					render();
				});
				actions.appendChild(toggleLog);

				if (userSubs.length > 0) {
					const resetBtn = el("button", "gl-link-btn", "Reset custom");
					resetBtn.type = "button";
					resetBtn.addEventListener("click", () => {
						saveUserSubmissions([]);
						render();
					});
					actions.appendChild(resetBtn);
				}

				nav.appendChild(actions);
			}

			dossier.appendChild(nav);

			if (activeDossierTab === "submissions") {
				dossier.appendChild(buildSubmissionsPanel(gpu, theo, workload, gpuSubs));
			} else if (activeDossierTab === "models-matrix") {
				dossier.appendChild(buildModelsMatrixPanel(gpu, workload));
			} else {
				dossier.appendChild(buildHardwarePanel(gpu, theo, workload));
			}

			return dossier;
		};

		const buildLedgerEntry = (
			item: LadderRowItem,
			rankLabel: string,
			workload: WorkloadConfig,
			maxScale: number,
			isOomRow: boolean,
			submissions: RealWorldSubmission[],
			userSubs: RealWorldSubmission[],
		): HTMLElement => {
			const { gpu, theo, actual, totalBandwidthGbs, totalComputeTflops, metricValue } = item;
			const isExpanded = expandedGpuId === gpu.id;

			const entry = el("div", "gl-entry");
			entry.dataset.gpuId = gpu.id;
			entry.dataset.expanded = String(isExpanded);

			const rowBtn = el("button", isOomRow ? "gl-row gl-row--oom" : "gl-row");
			rowBtn.type = "button";
			rowBtn.setAttribute("aria-expanded", String(isExpanded));
			rowBtn.dataset.focusId = `row:${gpu.id}`;
			rowBtn.addEventListener("click", () => {
				expandedGpuId = isExpanded ? null : gpu.id;
				logFormOpen = false;
				draftDecodeValue = "";
				draftPrefillValue = "";
				draftEngineValue = "";
				draftNotesValue = "";
				draftGpuCount = null;
				render();
			});

			const top = el("div", "gl-row-top");
			const rankEl = el("span", "gl-rank", rankLabel);

			const identity = el("div", "gl-identity");
			const prefix = workload.gpuCount > 1 ? `${workload.gpuCount}× ` : "";
			append(
				identity,
				el("span", "gl-name", `${prefix}${formatGpuShortName(gpu)}`),
				el("span", "gl-meta", `${gpu.vendor} · ${theo.availableVramGb} GB`),
			);

			const metrics = el("div", "gl-metrics");
			const subSpan = el("span", "gl-sub-val");
			const mainSpan = el("span", "gl-main-val");

			const setMain = (val: string, unit?: string) => {
				mainSpan.textContent = "";
				mainSpan.appendChild(document.createTextNode(val));
				if (unit) {
					mainSpan.appendChild(document.createTextNode(" "));
					mainSpan.appendChild(el("span", "gl-unit", unit));
				}
			};

			if (isOomRow) {
				subSpan.textContent = `${theo.totalVramGb.toFixed(1)} / ${theo.availableVramGb} GB`;
				setMain(`short ${(theo.totalVramGb - theo.availableVramGb).toFixed(1)}`, "GB");
			} else if (sortMetric === "memBandwidthGbs") {
				subSpan.textContent =
					theo.vramStatus === "oom" ? "OOM" : `${theo.decodeSingleTps.toFixed(1)} tok/s`;
				setMain(totalBandwidthGbs.toLocaleString(), "GB/s");
			} else if (sortMetric === "computeTflops") {
				const capLabel = capabilityFilter === "all" ? "FP16" : capabilityFilter.toUpperCase();
				subSpan.textContent = `${totalBandwidthGbs.toLocaleString()} GB/s`;
				setMain(totalComputeTflops.toLocaleString(), `${capLabel} TFLOPS`);
			} else if (sortMetric === "actualDecodeTps") {
				subSpan.textContent = `ceiling ${theo.decodeSingleTps.toFixed(1)}`;
				if (actual.actualDecodeTps != null) {
					setMain(actual.actualDecodeTps.toFixed(1), "tok/s");
				} else {
					setMain("—", "tok/s");
				}
			} else if (sortMetric === "prefillTps") {
				subSpan.textContent = `TTFT ${theo.ttftMs.toFixed(0)} ms`;
				setMain(Math.round(theo.prefillTps).toLocaleString(), "tok/s");
			} else {
				subSpan.textContent =
					actual.actualDecodeTps != null
						? `${actual.actualDecodeTps.toFixed(1)} actual`
						: `${theo.tpotMs.toFixed(1)} ms`;
				setMain(theo.decodeSingleTps.toFixed(1), "tok/s");
			}

			append(metrics, subSpan, mainSpan, createChevronSvg());
			append(top, rankEl, identity, metrics);
			rowBtn.appendChild(top);

			// Horizon proportional bar (omitted on OOM rows)
			if (!isOomRow) {
				const track = el("div", "gl-bar-track");
				if (sortMetric === "decodeSingleTps" || sortMetric === "actualDecodeTps") {
					const theoPct = Math.min(100, Math.max(2, (theo.decodeSingleTps / maxScale) * 100));
					const ceilBar = el("div", "gl-bar-ceiling");
					ceilBar.style.width = `${theoPct}%`;
					const tick = el("div", "gl-bar-tick");
					tick.style.left = `calc(${theoPct}% - 1.5px)`;
					append(track, ceilBar, tick);

					if (actual.actualDecodeTps != null) {
						const actPct = Math.min(100, Math.max(1.5, (actual.actualDecodeTps / maxScale) * 100));
						const actBar = el("div", "gl-bar-actual");
						actBar.style.width = `${actPct}%`;
						track.appendChild(actBar);
					}
				} else {
					const pct = Math.min(100, Math.max(2, (metricValue / maxScale) * 100));
					const fill = el("div", "gl-bar-single");
					fill.style.width = `${pct}%`;
					track.appendChild(fill);
				}
				rowBtn.appendChild(track);
			}

			entry.appendChild(rowBtn);

			if (isExpanded) {
				entry.appendChild(buildDossier(item, workload, submissions, userSubs));
			}

			return entry;
		};

		const resetAllFilters = () => {
			vendorFilter = "all";
			capabilityFilter = "all";
			hideOomCheckbox.checked = false;
			gpuSearchInput.value = "";
			render();
		};

		const render = () => {
			const activeFocusId =
				document.activeElement instanceof HTMLElement &&
				ladderRegion.contains(document.activeElement)
					? document.activeElement.dataset.focusId
					: undefined;
			const restoreFocus = () => {
				if (!activeFocusId) return;
				const next = ladderRegion.querySelector<HTMLElement>(
					`[data-focus-id="${CSS.escape(activeFocusId)}"]`,
				);
				next?.focus({ preventScroll: true });
			};

			syncControlsUi();
			const workload = readWorkload();
			syncSummaryLine(workload);
			syncUrlState();

			const userSubs = loadUserSubmissions();
			const submissions = [...userSubs, ...INITIAL_COMMUNITY_SUBMISSIONS];
			const query = gpuSearchInput.value.trim().toLowerCase();
			const hideOom = hideOomCheckbox.checked;
			const isHardwareRawSort = sortMetric === "memBandwidthGbs" || sortMetric === "computeTflops";

			barLegendEl.classList.toggle(
				"hidden",
				sortMetric !== "decodeSingleTps" && sortMetric !== "actualDecodeTps",
			);

			const filteredItems: LadderRowItem[] = GPU_CATALOG.filter((gpu) => {
				if (!gpuSupportsHardwarePrecision(gpu, capabilityFilter)) return false;
				if (vendorFilter !== "all" && gpu.vendor !== vendorFilter) return false;
				if (
					query &&
					!gpu.name.toLowerCase().includes(query) &&
					!gpu.architecture.toLowerCase().includes(query) &&
					!gpu.vendor.toLowerCase().includes(query)
				) {
					return false;
				}
				return true;
			}).map((gpu) => {
				const theo = evaluateGpuPerformance(gpu, currentModel, workload);
				const actual = resolveActualBenchmarkForGpu(gpu, theo, submissions);
				const totalBandwidthGbs = gpu.memBandwidthGbs * workload.gpuCount;
				const totalComputeTflops =
					getHardwareTflopsByCapability(gpu, capabilityFilter) * workload.gpuCount;

				const metricValue =
					sortMetric === "memBandwidthGbs"
						? totalBandwidthGbs
						: sortMetric === "computeTflops"
							? totalComputeTflops
							: theo.vramStatus === "oom"
								? 0
								: sortMetric === "actualDecodeTps"
									? (actual.actualDecodeTps ?? 0)
									: sortMetric === "prefillTps"
										? theo.prefillTps
										: theo.decodeSingleTps;

				return {
					gpu,
					theo,
					actual,
					totalBandwidthGbs,
					totalComputeTflops,
					metricValue,
				};
			});

			ladderRegion.replaceChildren();

			if (filteredItems.length === 0) {
				resultCountEl.textContent = "0 accelerators";
				const empty = el("div", "gl-empty-state");
				empty.appendChild(el("span", "gl-muted-text", "No accelerators match current filters."));
				const resetBtn = el("button", "gl-link-btn", "Reset filters");
				resetBtn.type = "button";
				resetBtn.addEventListener("click", resetAllFilters);
				empty.appendChild(resetBtn);
				ladderRegion.appendChild(empty);
				return;
			}

			if (isHardwareRawSort) {
				filteredItems.sort((a, b) => b.metricValue - a.metricValue);
				const maxVal = Math.max(1, ...filteredItems.map((i) => i.metricValue));
				resultCountEl.textContent = `${filteredItems.length} ${
					filteredItems.length === 1 ? "accelerator" : "accelerators"
				}`;

				const ledger = el("div", "gl-ledger");
				ledger.setAttribute("role", "list");
				for (const [idx, item] of filteredItems.entries()) {
					ledger.appendChild(
						buildLedgerEntry(item, String(idx + 1), workload, maxVal, false, submissions, userSubs),
					);
				}
				ladderRegion.appendChild(ledger);
				restoreFocus();
				return;
			}

			const fittingItems = filteredItems.filter((i) => i.theo.vramStatus !== "oom");
			const oomItems = filteredItems.filter((i) => i.theo.vramStatus === "oom");

			fittingItems.sort((a, b) => {
				if (sortMetric === "actualDecodeTps") {
					const aVal = a.actual.actualDecodeTps ?? -1;
					const bVal = b.actual.actualDecodeTps ?? -1;
					if (bVal !== aVal) return bVal - aVal;
					return b.theo.decodeSingleTps - a.theo.decodeSingleTps;
				}
				return b.metricValue - a.metricValue;
			});

			oomItems.sort((a, b) => b.theo.availableVramGb - a.theo.availableVramGb);

			resultCountEl.textContent = `${fittingItems.length} ${
				fittingItems.length === 1 ? "configuration" : "configurations"
			}`;

			if (fittingItems.length === 0) {
				barLegendEl.classList.add("hidden");
			}

			if (fittingItems.length === 0) {
				const minReqGb = Math.min(...oomItems.map((i) => i.theo.totalVramGb));
				const zeroBox = el("div", "gl-empty-state");
				const capWord =
					workload.gpuCount === 1 ? "1× single-device" : `${workload.gpuCount}× configuration`;
				zeroBox.appendChild(
					el(
						"span",
						"gl-muted-text",
						`Requires ${minReqGb.toFixed(1)} GB VRAM — exceeds ${capWord} capacity.`,
					),
				);

				const actions = el("div", "flex flex-wrap items-center gap-2");
				const suggestedCount = GPU_COUNT_OPTIONS.find(
					(n) =>
						n > workload.gpuCount &&
						filteredItems.some(
							(i) =>
								evaluateGpuPerformance(i.gpu, currentModel, { ...workload, gpuCount: n })
									.vramStatus !== "oom",
						),
				);
				if (suggestedCount) {
					const scaleBtn = el("button", "gl-btn-subtle", `Switch to ${suggestedCount}× GPUs`);
					scaleBtn.type = "button";
					scaleBtn.addEventListener("click", () => {
						gpuCount = suggestedCount;
						render();
					});
					actions.appendChild(scaleBtn);
				}

				if (workload.weightPrecision !== "int4") {
					const int4Btn = el("button", "gl-btn-subtle", "Use INT4");
					int4Btn.type = "button";
					int4Btn.addEventListener("click", () => {
						weightPrecision = "int4";
						render();
					});
					actions.appendChild(int4Btn);
				}

				zeroBox.appendChild(actions);
				ladderRegion.appendChild(zeroBox);
			} else {
				const maxScale =
					sortMetric === "decodeSingleTps" || sortMetric === "actualDecodeTps"
						? Math.max(
								1,
								...fittingItems.map((i) =>
									Math.max(i.theo.decodeSingleTps, i.actual.actualDecodeTps ?? 0),
								),
							)
						: Math.max(1, ...fittingItems.map((i) => i.metricValue));

				const ledger = el("div", "gl-ledger");
				ledger.setAttribute("role", "list");
				for (const [idx, item] of fittingItems.entries()) {
					ledger.appendChild(
						buildLedgerEntry(
							item,
							String(idx + 1),
							workload,
							maxScale,
							false,
							submissions,
							userSubs,
						),
					);
				}
				ladderRegion.appendChild(ledger);
			}

			if (!hideOom && oomItems.length > 0) {
				const firstOom = oomItems[0];
				const reqGb = firstOom ? firstOom.theo.totalVramGb : 0;
				const details = el("details", "gl-oom-details");
				const hasExpandedOom = oomItems.some((i) => i.gpu.id === expandedGpuId);
				if (fittingItems.length < 3 || hasExpandedOom) {
					details.open = true;
				}

				const summary = el("summary", "gl-oom-summary");
				append(
					summary,
					el(
						"span",
						undefined,
						`Insufficient VRAM (${oomItems.length}) · needs ${reqGb.toFixed(1)} GB`,
					),
					createChevronSvg(),
				);
				details.appendChild(summary);

				const oomLedger = el("div", "gl-ledger");
				oomLedger.setAttribute("role", "list");
				for (const item of oomItems) {
					oomLedger.appendChild(
						buildLedgerEntry(item, "—", workload, 1, true, submissions, userSubs),
					);
				}
				details.appendChild(oomLedger);
				ladderRegion.appendChild(details);
			}
			restoreFocus();
		};

		// Bind interactive controls
		for (const btn of precisionButtons) {
			btn.addEventListener("click", () => {
				const next = btn.dataset.precision as Precision | undefined;
				if (!next) return;
				weightPrecision = next;
				render();
			});
		}

		for (const btn of gpuCountButtons) {
			btn.addEventListener("click", () => {
				const next = Number(btn.dataset.gpuCount);
				if (!next) return;
				gpuCount = next;
				render();
			});
		}

		customizeToggle.addEventListener("click", () => {
			const open = customizePanel.classList.toggle("hidden");
			customizeToggle.setAttribute("aria-expanded", String(!open));
		});

		filterToggle.addEventListener("click", () => {
			const open = filterPanel.classList.toggle("hidden");
			filterToggle.setAttribute("aria-expanded", String(!open));
		});

		filterResetBtn.addEventListener("click", resetAllFilters);

		for (const btn of sortButtons) {
			btn.addEventListener("click", () => {
				const next = btn.dataset.sortMetric as LadderSortMetric | undefined;
				if (!next) return;
				sortMetric = next;
				render();
			});
		}

		for (const btn of vendorButtons) {
			btn.addEventListener("click", () => {
				vendorFilter = (btn.dataset.vendorFilter as GpuVendor | "all") ?? "all";
				render();
			});
		}

		for (const btn of capButtons) {
			btn.addEventListener("click", () => {
				capabilityFilter = (btn.dataset.capFilter as HardwarePrecision | "all") ?? "all";
				render();
			});
		}

		modelSelect.addEventListener("change", () => {
			if (modelSelect.value === "custom") {
				customizePanel.classList.remove("hidden");
				customizeToggle.setAttribute("aria-expanded", "true");
				hfInput.focus();
				return;
			}
			const preset = MODEL_CATALOG.find((m) => m.id === modelSelect.value);
			if (preset) {
				currentModel = { ...preset };
				hfInput.value = preset.hfRepoId;
				if (preset.defaultPrecision) {
					weightPrecision = preset.defaultPrecision;
				}
				render();
			}
		});

		const onCustomParamEdit = () => {
			modelSelect.value = "custom";
			const totalB = Math.max(0.1, Number(paramTotalInput.value) || 7);
			const activeB = Math.min(totalB, Math.max(0.1, Number(paramActiveInput.value) || totalB));
			currentModel = {
				...currentModel,
				id: "custom",
				name: hfInput.value.trim() || `Custom ${totalB}B`,
				architecture: activeB < totalB * 0.95 ? "moe" : "dense",
				totalParamsB: totalB,
				activeParamsB: activeB,
			};
			render();
		};

		paramTotalInput.addEventListener("input", onCustomParamEdit);
		paramActiveInput.addEventListener("input", onCustomParamEdit);

		for (const inputEl of [
			inputTokensInput,
			outputTokensInput,
			batchSizeInput,
			gpuSearchInput,
			hideOomCheckbox,
		]) {
			inputEl.addEventListener("input", render);
			inputEl.addEventListener("change", render);
		}

		const setHfStatus = (msg: string, isError = false) => {
			hfStatus.textContent = msg;
			hfStatus.classList.toggle("hidden", !msg);
			hfStatus.classList.toggle("gl-status--error", isError);
		};

		hfFetchBtn.addEventListener("click", async () => {
			const repoId = parseHuggingFaceModelRef(hfInput.value);
			if (!repoId) {
				setHfStatus("Enter org/repo or a huggingface.co repository URL.", true);
				return;
			}

			hfFetchBtn.disabled = true;
			setHfStatus(`Loading ${repoId}…`);

			try {
				const [apiRes, configRes] = await Promise.allSettled([
					fetch(`https://huggingface.co/api/models/${repoId}`),
					fetch(`https://huggingface.co/${repoId}/resolve/main/config.json`),
				]);

				let safetensorsTotal: number | null = null;
				if (apiRes.status === "fulfilled" && apiRes.value.ok) {
					const meta = (await apiRes.value.json()) as {
						safetensors?: { total?: number };
					};
					safetensorsTotal = meta.safetensors?.total ?? null;
				}

				if (configRes.status === "fulfilled" && configRes.value.ok) {
					const rawConfig = (await configRes.value.json()) as Record<string, unknown>;
					const parsed = parseHuggingFaceConfig(repoId, rawConfig, safetensorsTotal);
					currentModel = parsed;
					modelSelect.value = "custom";
					if (parsed.defaultPrecision) {
						weightPrecision = parsed.defaultPrecision;
					}
					setHfStatus(
						`Loaded ${repoId}: ${parsed.architecture.toUpperCase()} ${parsed.totalParamsB}B (${parsed.activeParamsB}B active), ${parsed.numLayers} layers.`,
					);
					render();
					return;
				}

				const inferred = inferModelSpecFromRepoId(repoId);
				if (inferred) {
					currentModel = inferred;
					modelSelect.value = "custom";
					if (inferred.defaultPrecision) {
						weightPrecision = inferred.defaultPrecision;
					}
					setHfStatus(
						`Inferred ${repoId}: ${inferred.totalParamsB}B total / ${inferred.activeParamsB}B active.`,
					);
					render();
					return;
				}

				throw new Error(`Could not fetch or infer config for ${repoId}.`);
			} catch (err) {
				setHfStatus(err instanceof Error ? err.message : "Failed to load HuggingFace model.", true);
			} finally {
				hfFetchBtn.disabled = false;
			}
		});

		hydrateFromUrl();
		hfInput.value = currentModel.hfRepoId;
		render();
	}
</script>
