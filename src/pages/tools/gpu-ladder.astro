---
import PageLayout from "@/layouts/Base.astro";
import { DATA_SOURCES_REGISTRY, formatModelShortName, MODEL_CATALOG } from "@/lib/tools/gpu-ladder";

const denseModels = MODEL_CATALOG.filter((model) => model.architecture === "dense");
const moeModels = MODEL_CATALOG.filter((model) => model.architecture === "moe");
---

<PageLayout
	meta={{
		title: "GPU Ladder",
		description:
			"LLM Roofline throughput ceilings and empirical GPU efficiency across AI accelerators.",
	}}
>
	<section class="gl-root space-y-6" data-gpu-ladder>
		<header class="space-y-2">
			<a href="/tools/" class="cactus-link text-xs">Tools</a>
			<h1 class="title">GPU ladder</h1>
		</header>

		<!-- Depth 0: Primary Workload Controls -->
		<div class="space-y-2.5">
			<div class="gl-workload-bar">
				<select class="gl-select gl-model-select" aria-label="Model" data-model-select>
					<optgroup label="Dense">
						{
							denseModels.map((model) => (
								<option value={model.id} selected={model.id === "qwen3-32b"}>
									{formatModelShortName(model)} · {model.totalParamsB}B
								</option>
							))
						}
					</optgroup>
					<optgroup label="Mixture of Experts">
						{
							moeModels.map((model) => (
								<option value={model.id}>
									{formatModelShortName(model)} · {model.totalParamsB}B ({model.activeParamsB}B
									active)
								</option>
							))
						}
					</optgroup>
					<optgroup label="Custom">
						<option value="custom" data-custom-option>Custom / HuggingFace repo…</option>
					</optgroup>
				</select>

				<div class="gl-seg" role="radiogroup" aria-label="Weight precision" data-precision-group>
					<button type="button" role="radio" aria-checked="false" data-precision="fp16">
						FP16
					</button>
					<button type="button" role="radio" aria-checked="false" data-precision="fp8">
						FP8
					</button>
					<button type="button" role="radio" aria-checked="false" data-precision="int8">
						INT8
					</button>
					<button type="button" role="radio" aria-checked="true" data-precision="int4">
						INT4
					</button>
				</div>

				<div class="gl-seg" role="radiogroup" aria-label="GPU count" data-gpu-count-group>
					<button type="button" role="radio" aria-checked="true" data-gpu-count="1">1×</button>
					<button type="button" role="radio" aria-checked="false" data-gpu-count="2">2×</button>
					<button type="button" role="radio" aria-checked="false" data-gpu-count="4">4×</button>
					<button type="button" role="radio" aria-checked="false" data-gpu-count="8">8×</button>
					<button type="button" role="radio" aria-checked="false" data-gpu-count="16">16×</button>
				</div>
			</div>

			<div class="gl-context-row">
				<p class="gl-summary tabular-nums" data-workload-summary>
					32.8B dense · 21.0 GB · 2,048→512 tok
				</p>
				<button
					type="button"
					class="gl-disclosure-btn"
					aria-expanded="false"
					aria-controls="gl-customize-panel"
					data-customize-toggle
				>
					<span>Customize</span>
					<svg
						aria-hidden="true"
						class="gl-chevron"
						viewBox="0 0 12 12"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
					>
						<path d="M3 4.5L6 7.5L9 4.5" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</button>
			</div>

			<!-- Progressive Disclosure: Custom HuggingFace & Sequence Drawer -->
			<div id="gl-customize-panel" class="gl-drawer hidden space-y-3" data-customize-panel>
				<div class="flex flex-wrap items-center gap-2">
					<input
						class="gl-input min-w-0 flex-1"
						type="text"
						aria-label="HuggingFace repository"
						placeholder="org/repo or huggingface.co/..."
						autocomplete="off"
						spellcheck="false"
						data-hf-input
					/>
					<button type="button" class="gl-btn-subtle shrink-0" data-hf-fetch>Load</button>
				</div>
				<p class="gl-status hidden text-xs" data-hf-status aria-live="polite" role="status"></p>
				<div class="grid grid-cols-2 gap-3 sm:grid-cols-5">
					<label class="gl-field">
						<span>Total B</span>
						<input
							class="gl-input tabular-nums"
							type="number"
							min="0.1"
							step="0.1"
							value="32.8"
							data-param-total
						/>
					</label>
					<label class="gl-field">
						<span>Active B</span>
						<input
							class="gl-input tabular-nums"
							type="number"
							min="0.1"
							step="0.1"
							value="32.8"
							data-param-active
						/>
					</label>
					<label class="gl-field">
						<span>Prompt tok</span>
						<input
							class="gl-input tabular-nums"
							type="number"
							min="16"
							step="64"
							value="2048"
							data-input-tokens
						/>
					</label>
					<label class="gl-field">
						<span>Output tok</span>
						<input
							class="gl-input tabular-nums"
							type="number"
							min="16"
							step="64"
							value="512"
							data-output-tokens
						/>
					</label>
					<label class="gl-field">
						<span>Batch</span>
						<input
							class="gl-input tabular-nums"
							type="number"
							min="1"
							step="1"
							value="1"
							data-batch-size
						/>
					</label>
				</div>
			</div>
		</div>

		<!-- Metric Axis & On-Demand Filter Bar -->
		<div class="space-y-0">
			<div class="gl-axis-bar">
				<div class="gl-axis-tabs" role="tablist" aria-label="Ranking metric">
					<button
						type="button"
						role="tab"
						aria-selected="true"
						class="gl-axis-tab"
						data-sort-metric="decodeSingleTps"
					>
						Decode
					</button>
					<button
						type="button"
						role="tab"
						aria-selected="false"
						class="gl-axis-tab"
						data-sort-metric="actualDecodeTps"
					>
						Measured
					</button>
					<button
						type="button"
						role="tab"
						aria-selected="false"
						class="gl-axis-tab"
						data-sort-metric="prefillTps"
					>
						Prefill
					</button>
					<button
						type="button"
						role="tab"
						aria-selected="false"
						class="gl-axis-tab"
						data-sort-metric="memBandwidthGbs"
					>
						Bandwidth
					</button>
					<button
						type="button"
						role="tab"
						aria-selected="false"
						class="gl-axis-tab"
						data-sort-metric="computeTflops"
					>
						Compute
					</button>
				</div>

				<div class="gl-axis-tools">
					<input
						class="gl-search"
						type="search"
						placeholder="Search…"
						aria-label="Search GPUs"
						autocomplete="off"
						data-gpu-search
					/>
					<button
						type="button"
						class="gl-filter-toggle"
						aria-expanded="false"
						aria-controls="gl-filter-panel"
						data-filter-toggle
					>
						Filter
					</button>
				</div>
			</div>

			<!-- Progressive Disclosure: Vendor & Precision Filter Drawer -->
			<div id="gl-filter-panel" class="gl-drawer hidden space-y-2.5" data-filter-panel>
				<div class="gl-filter-row">
					<span class="gl-filter-label">Vendor</span>
					<div class="gl-chip-group" role="group" aria-label="Vendor">
						<button type="button" class="gl-chip" aria-pressed="true" data-vendor-filter="all">
							All
						</button>
						<button type="button" class="gl-chip" aria-pressed="false" data-vendor-filter="NVIDIA">
							NVIDIA
						</button>
						<button type="button" class="gl-chip" aria-pressed="false" data-vendor-filter="AMD">
							AMD
						</button>
						<button type="button" class="gl-chip" aria-pressed="false" data-vendor-filter="Apple">
							Apple
						</button>
						<button type="button" class="gl-chip" aria-pressed="false" data-vendor-filter="Huawei">
							Huawei
						</button>
						<button type="button" class="gl-chip" aria-pressed="false" data-vendor-filter="Intel">
							Intel
						</button>
						<button type="button" class="gl-chip" aria-pressed="false" data-vendor-filter="Google">
							Google
						</button>
					</div>
				</div>

				<div class="gl-filter-row">
					<span class="gl-filter-label">Hardware</span>
					<div class="flex flex-1 flex-wrap items-center justify-between gap-2">
						<div class="gl-chip-group" role="group" aria-label="Native precision">
							<button type="button" class="gl-chip" aria-pressed="true" data-cap-filter="all">
								All
							</button>
							<button type="button" class="gl-chip" aria-pressed="false" data-cap-filter="fp8">
								FP8
							</button>
							<button type="button" class="gl-chip" aria-pressed="false" data-cap-filter="int4">
								INT4
							</button>
							<button type="button" class="gl-chip" aria-pressed="false" data-cap-filter="bf16">
								BF16
							</button>
							<button type="button" class="gl-chip" aria-pressed="false" data-cap-filter="fp16">
								FP16
							</button>
							<button type="button" class="gl-chip" aria-pressed="false" data-cap-filter="int8">
								INT8
							</button>
						</div>

						<div class="flex items-center gap-3 text-xs">
							<label class="flex cursor-pointer items-center gap-1.5 select-none">
								<input type="checkbox" class="accent-accent" data-hide-oom />
								<span class="gl-muted-text">Fit in VRAM</span>
							</label>
							<button type="button" class="gl-link-btn hidden" data-filter-reset>Reset</button>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Depth 1: Horizon Ledger -->
		<div class="space-y-2">
			<div class="gl-subbar">
				<span data-result-count>29 configurations</span>
				<div class="gl-legend" data-bar-legend>
					<span class="gl-legend-item">
						<span class="gl-swatch gl-swatch-actual" aria-hidden="true"></span>
						<span>measured</span>
					</span>
					<span class="gl-legend-item">
						<span class="gl-swatch gl-swatch-ceiling" aria-hidden="true"></span>
						<span>ceiling</span>
					</span>
				</div>
			</div>

			<div data-ladder-region></div>
		</div>

		<!-- Colophon -->
		<details class="gl-colophon">
			<summary class="gl-colophon-summary">
				<span>Methodology &amp; primary sources</span>
				<svg
					aria-hidden="true"
					class="gl-chevron"
					viewBox="0 0 12 12"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
				>
					<path d="M3 4.5L6 7.5L9 4.5" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</summary>
			<div class="gl-colophon-body space-y-3">
				<p class="gl-muted-text text-xs leading-relaxed">
					Vendor datasheets often report 2:4 structured sparsity peaks or vector FLOPs. Every
					accelerator here is normalized to dense Tensor or Matrix Core throughput and compared
					against analytical memory-bandwidth and compute Roofline ceilings.
				</p>
				<ul class="space-y-2 text-xs">
					{
						DATA_SOURCES_REGISTRY.map((src) => (
							<li class="space-y-0.5">
								<div class="flex flex-wrap items-baseline gap-x-2">
									<a
										href={src.url}
										target="_blank"
										rel="noopener noreferrer"
										class="cactus-link font-medium"
									>
										{src.name} ↗
									</a>
									<span class="gl-muted-text text-[11px]">{src.license}</span>
								</div>
								<p class="gl-muted-text text-[11px] leading-snug">{src.description}</p>
							</li>
						))
					}
				</ul>
			</div>
		</details>
	</section>
</PageLayout>

<style is:global>
	.gl-root {
		--gl-ink: var(--color-accent-2);
		--gl-body: var(--color-global-text);
		--gl-muted: color-mix(in oklab, var(--color-global-text) 56%, var(--color-global-bg));
		--gl-line: color-mix(in oklab, var(--color-global-text) 12%, var(--color-global-bg));
		--gl-line-strong: color-mix(in oklab, var(--color-global-text) 24%, var(--color-global-bg));
		--gl-surface: color-mix(in oklab, var(--color-global-text) 3%, var(--color-global-bg));
		--gl-surface-hover: color-mix(in oklab, var(--color-global-text) 5.5%, var(--color-global-bg));
		--gl-bar-track: color-mix(in oklab, var(--color-global-text) 6%, transparent);
		--gl-bar-ceiling: color-mix(in oklab, var(--color-global-text) 15%, var(--color-global-bg));
		--gl-bar-cap: color-mix(in oklab, var(--color-global-text) 42%, var(--color-global-bg));
		--gl-bar-fill: color-mix(in oklab, var(--color-global-text) 62%, var(--color-global-bg));
	}

	[data-theme="dark"] .gl-root {
		--gl-bar-ceiling: color-mix(in oklab, var(--color-global-text) 20%, var(--color-global-bg));
		--gl-bar-cap: color-mix(in oklab, var(--color-global-text) 52%, var(--color-global-bg));
	}

	.gl-root .gl-muted-text {
		color: var(--gl-muted);
	}

	/* Primary Workload Strip */
	.gl-root .gl-workload-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
		gap: 0.5rem;
	}

	.gl-root .gl-select,
	.gl-root .gl-input,
	.gl-root .gl-search {
		border: 1px solid var(--gl-line-strong);
		border-radius: 3px;
		background-color: var(--color-global-bg);
		color: var(--gl-ink);
		font-size: 0.75rem;
		line-height: 1.2;
		transition: border-color 120ms ease;
	}

	.gl-root .gl-select {
		height: 2.125rem;
		padding: 0 0.5rem;
	}

	.gl-root .gl-model-select {
		flex: 1 1 15rem;
		min-width: 0;
		font-weight: 500;
	}

	.gl-root .gl-input {
		width: 100%;
		height: 2rem;
		padding: 0 0.5rem;
	}

	.gl-root .gl-select:hover,
	.gl-root .gl-input:hover,
	.gl-root .gl-search:hover {
		border-color: var(--gl-muted);
	}

	.gl-root .gl-seg {
		display: inline-flex;
		height: 2.125rem;
		border: 1px solid var(--gl-line-strong);
		border-radius: 3px;
		overflow: hidden;
		background-color: var(--color-global-bg);
	}

	.gl-root .gl-seg button {
		padding: 0 0.55rem;
		font-size: 0.75rem;
		color: var(--gl-muted);
		border-right: 1px solid var(--gl-line);
		white-space: nowrap;
		cursor: pointer;
		transition:
			color 120ms ease,
			background-color 120ms ease;
	}

	.gl-root .gl-seg button:last-child {
		border-right: 0;
	}

	.gl-root .gl-seg button:hover {
		color: var(--gl-ink);
	}

	.gl-root .gl-seg button[aria-checked="true"] {
		background-color: color-mix(in oklab, var(--color-global-text) 9%, var(--color-global-bg));
		color: var(--gl-ink);
		font-weight: 600;
	}

	.gl-root .gl-context-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.375rem 1rem;
		font-size: 0.75rem;
	}

	.gl-root .gl-summary {
		color: var(--gl-muted);
	}

	.gl-root .gl-disclosure-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.75rem;
		color: var(--gl-muted);
		cursor: pointer;
		transition: color 120ms ease;
	}

	.gl-root .gl-disclosure-btn:hover,
	.gl-root .gl-disclosure-btn[aria-expanded="true"] {
		color: var(--gl-ink);
	}

	.gl-root .gl-chevron {
		width: 0.75rem;
		height: 0.75rem;
		flex: none;
		transition: transform 140ms ease;
	}

	.gl-root [aria-expanded="true"] .gl-chevron,
	.gl-root details[open] > summary .gl-chevron {
		transform: rotate(180deg);
	}

	.gl-root .gl-drawer {
		background-color: var(--gl-surface);
		border-top: 1px solid var(--gl-line);
		border-bottom: 1px solid var(--gl-line);
		padding: 0.75rem;
	}

	.gl-root .gl-field {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: 0.6875rem;
		color: var(--gl-muted);
	}

	.gl-root .gl-btn-subtle {
		height: 2rem;
		padding: 0 0.75rem;
		border: 1px solid var(--gl-line-strong);
		border-radius: 3px;
		background-color: var(--color-global-bg);
		color: var(--gl-ink);
		font-size: 0.75rem;
		font-weight: 500;
		cursor: pointer;
		transition:
			border-color 120ms ease,
			color 120ms ease;
	}

	.gl-root .gl-btn-subtle:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.gl-root .gl-btn-subtle:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}

	.gl-root .gl-status {
		color: var(--gl-muted);
	}

	.gl-root .gl-status--error {
		color: #dc2626;
	}

	[data-theme="dark"] .gl-root .gl-status--error {
		color: #f87171;
	}

	/* Metric Axis & Filter Bar */
	.gl-root .gl-axis-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		border-bottom: 1px solid var(--gl-line-strong);
	}

	.gl-root .gl-axis-tabs {
		display: flex;
		align-items: center;
		gap: 0.125rem;
		margin-bottom: -1px;
		overflow-x: auto;
		overflow-y: hidden;
		scrollbar-width: none;
		max-width: 100%;
	}

	.gl-root .gl-axis-tabs::-webkit-scrollbar {
		display: none;
	}

	.gl-root .gl-axis-tab {
		padding: 0.45rem 0.55rem;
		border-bottom: 2px solid transparent;
		font-size: 0.75rem;
		color: var(--gl-muted);
		white-space: nowrap;
		cursor: pointer;
		transition:
			color 120ms ease,
			border-color 120ms ease;
	}

	.gl-root .gl-axis-tab:hover {
		color: var(--gl-ink);
	}

	.gl-root .gl-axis-tab[aria-selected="true"] {
		color: var(--gl-ink);
		border-bottom-color: var(--color-accent);
		font-weight: 600;
	}

	.gl-root .gl-axis-tools {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding-bottom: 0.375rem;
	}

	.gl-root .gl-search {
		height: 1.75rem;
		width: 7.5rem;
		padding: 0 0.45rem;
		border-color: var(--gl-line);
	}

	.gl-root .gl-filter-toggle {
		height: 1.75rem;
		padding: 0 0.5rem;
		border: 1px solid var(--gl-line);
		border-radius: 3px;
		font-size: 0.75rem;
		color: var(--gl-muted);
		white-space: nowrap;
		cursor: pointer;
		transition:
			border-color 120ms ease,
			color 120ms ease;
	}

	.gl-root .gl-filter-toggle:hover,
	.gl-root .gl-filter-toggle[aria-expanded="true"],
	.gl-root .gl-filter-toggle[data-active="true"] {
		border-color: var(--gl-line-strong);
		color: var(--gl-ink);
	}

	.gl-root .gl-filter-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.375rem 0.75rem;
		font-size: 0.75rem;
	}

	.gl-root .gl-filter-label {
		width: 4.5rem;
		flex: none;
		font-size: 0.6875rem;
		color: var(--gl-muted);
	}

	.gl-root .gl-chip-group {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
	}

	.gl-root .gl-chip {
		padding: 0.15rem 0.45rem;
		border: 1px solid transparent;
		border-radius: 3px;
		font-size: 0.75rem;
		color: var(--gl-muted);
		cursor: pointer;
		transition:
			color 120ms ease,
			border-color 120ms ease,
			background-color 120ms ease;
	}

	.gl-root .gl-chip:hover {
		color: var(--gl-ink);
	}

	.gl-root .gl-chip[aria-pressed="true"] {
		border-color: var(--gl-line-strong);
		background-color: var(--color-global-bg);
		color: var(--gl-ink);
		font-weight: 600;
	}

	.gl-root .gl-link-btn {
		font-size: 0.75rem;
		color: var(--gl-muted);
		text-decoration: underline;
		text-underline-offset: 2px;
		cursor: pointer;
	}

	.gl-root .gl-link-btn:hover {
		color: var(--color-accent);
	}

	/* Sub-bar & Legend */
	.gl-root .gl-subbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		font-size: 0.6875rem;
		color: var(--gl-muted);
		font-variant-numeric: tabular-nums;
	}

	.gl-root .gl-legend {
		display: inline-flex;
		align-items: center;
		gap: 0.875rem;
	}

	.gl-root .gl-legend-item {
		display: inline-flex;
		align-items: center;
