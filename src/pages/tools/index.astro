---
import PageLayout from "@/layouts/Base.astro";

const tools = [
	{ href: "access/", title: "Access", description: "Inspect your session and token." },
	{ href: "mail/", title: "Email", description: "Read routed messages." },
	{
		href: "camera/",
		title: "Camera",
		description: "Calculate depth of field and equivalent focal lengths.",
	},
	{ href: "exchange/", title: "Exchange rates", description: "View buy, sell, and middle rates." },
	{ href: "network/", title: "Network", description: "Look up IP addresses and Internet health." },
	{
		href: "lut-to-np3/",
		title: "LUT to NP3",
		description: "Convert supported .cube LUTs to approximate Nikon profiles.",
	},
];
---

<PageLayout meta={{ title: "Tools" }}>
	<h1 class="title mb-8">Tools</h1>
	<ul class="space-y-5" role="list">
		{
			tools.map((tool) => (
				<li>
					<a class="cactus-link font-semibold" href={`/tools/${tool.href}`}>
						{tool.title}
					</a>
					<p class="text-global-text/75 mt-1">{tool.description}</p>
				</li>
			))
		}
	</ul>
</PageLayout>
