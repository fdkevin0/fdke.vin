---
import { env } from "cloudflare:workers";
import CopyButton from "@/components/ui/CopyButton.astro";
import PageLayout from "@/layouts/Base.astro";
import { readConnection } from "@/lib/network/connection";
import { LOOKUP_HOST, lookupResponse } from "@/lib/network/handler";
import type { IpProfile } from "@/lib/network/profile";
import { addressView } from "@/lib/network/render";
import { parseIp, parseLookupTarget } from "@/lib/network/target";

export const prerender = false;

const connection = readConnection(Astro.request);
const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const target = query ? parseLookupTarget(encodeURIComponent(query)) : null;
const ownAddress = !query || (target?.kind === "ip" && target.ip === parseIp(connection.ip));
let cards = ownAddress ? [addressView(connection)] : [];
let error = "";
Astro.response.headers.set("Cache-Control", "no-store");

if (!ownAddress) {
	if (!target) {
		error = "Enter a valid IPv4 address, IPv6 address, or hostname.";
		Astro.response.status = 400;
	} else {
		try {
			// Reuse the curl host's validation result, cache and Radar error handling.
			const response = await lookupResponse(
				new Request(`https://${LOOKUP_HOST}/`),
				target,
				true,
				true,
				{
					token: env.RADAR_API_TOKEN,
					cache: (caches as unknown as { default?: Cache }).default,
				},
			);
			if (!response.ok) {
				error = ((await response.json()) as { error: string }).error;
				Astro.response.status = response.status;
				const retryAfter = response.headers.get("Retry-After");
				if (retryAfter) Astro.response.headers.set("Retry-After", retryAfter);
			} else {
				const result = (await response.json()) as IpProfile | { profiles: IpProfile[] };
				cards = ("profiles" in result ? result.profiles : [result]).map(addressView);
			}
		} catch {
			error = "Lookup failed. Please try again.";
			Astro.response.status = 502;
		}
	}
}
---

<PageLayout
	meta={{
		title: "Network",
		description: "IP address lookup and Internet health.",
	}}
>
	<section class="tool-workbench space-y-8">
		<header class="space-y-4">
			<a href="/tools/" class="cactus-link text-xs">Tools</a>
			<h1 class="title">Network</h1>
		</header>
		<form method="get" action="/tools/network" class="space-y-2">
			<label class="tool-field-label" for="network-lookup">IP or hostname</label>
			<div class="flex flex-wrap items-center gap-3">
				<input
					id="network-lookup"
					name="q"
					type="text"
					value={query}
					autocomplete="off"
					autocapitalize="off"
					autocorrect="off"
					spellcheck="false"
					placeholder="1.1.1.1 or github.com"
					class="tool-input min-w-0 flex-1"
				/>
				<button type="submit" class="tool-button">Look up</button>
				{
					query && (
						<a href="/tools/network" class="cactus-link">
							Your address
						</a>
					)
				}
			</div>
		</form>
		{
			error ? (
				<p role="alert">{error}</p>
			) : cards.length === 0 ? (
				<p>No A or AAAA records found for {query}.</p>
			) : (
				cards.map((card) => (
					<section class="space-y-4" data-address-card>
						<h2 class="text-accent-2 text-lg font-semibold">
							{ownAddress ? "Your address" : "Address"}
						</h2>
						{card.ip ? (
							<div class="space-y-2">
								<div class="flex flex-wrap items-center gap-2">
									<p class="text-xl break-all tabular-nums" translate="no">
										{card.ip}
									</p>
									<CopyButton value={card.ip} label="IP address" />
								</div>
								{card.identity && <p class="tool-note">{card.identity}</p>}
							</div>
						) : (
							<p>Your address is unavailable. Enter an IP above.</p>
						)}
						{card.rows.length > 0 && (
							<dl class="tool-rows">
								{card.rows.map(([label, value]) => (
									<div class="tool-row">
										<dt>{label}</dt>
										<dd class="flex items-center justify-between gap-2" translate="no">
											<span class="min-w-0 break-words">{value}</span>
											<CopyButton value={value} label={label} />
										</dd>
									</div>
								))}
							</dl>
						)}
					</section>
				))
			)
		}
		{
			!error && cards.length > 0 && (
				<div class="space-y-2">
					{!ownAddress && (
						<p class="tool-note">
							Location is country-level; TLS and RTT describe your own connection only.
						</p>
					)}
					<code class="block overflow-x-auto text-xs whitespace-nowrap" translate="no">
						curl {LOOKUP_HOST}
						{ownAddress ? "" : `/${encodeURIComponent(query)}`}?detail=1
					</code>
				</div>
			)
		}
		<p class="tool-note">
			Source: {ownAddress && "your connection and "}
			<a class="cactus-link" href="https://radar.cloudflare.com/">Cloudflare Radar</a>.
		</p>
		<network-panels data-country={connection.country ?? ""} class="block space-y-8">
			<section class="tool-panel space-y-4">
				<h2 class="title text-lg">
					Adoption <span class="text-global-text/75 text-sm font-normal">· 7 days</span>
				</h2>
				<div data-adoption aria-busy="true"><span class="tool-note">Loading…</span></div>
			</section>
			<section class="tool-panel space-y-4">
				<h2 class="title text-lg">Internet health</h2>
				<div data-health aria-busy="true"><span class="tool-note">Loading…</span></div>
			</section>
			<section class="tool-panel space-y-4">
				<h2 class="title text-lg">Routing</h2>
				<div data-routing aria-busy="true"><span class="tool-note">Loading…</span></div>
			</section>
			<section class="tool-panel space-y-4">
				<h2 class="title text-lg">Rankings &amp; attacks</h2>
				<div data-rankings aria-busy="true"><span class="tool-note">Loading…</span></div>
			</section>
		</network-panels>
	</section>
</PageLayout>

<script>
	// The group readers define these shapes; importing them means a field added
	// or renamed there is a type error here rather than a silently blank panel.
	// `import type` is erased at build, so this pulls no server code client-side.
	import type {
		AdoptionSnapshot,
		HealthSnapshot,
		RankingsSnapshot,
		RoutingSnapshot,
	} from "@/lib/network/datasets";
	import { renderDataTable } from "@/lib/network/table";

	// The reader's own locale decides how these dates read, so the format is
	// resolved once here rather than hardcoded at each call site.
	const dateFormat = new Intl.DateTimeFormat(undefined, {
		day: "numeric",
		month: "short",
		year: "numeric",
		hour: "2-digit",
		minute: "2-digit",
	});

	const date = (value: string | null) => {
		if (!value) return null;
		const parsed = new Date(value);
		return Number.isNaN(parsed.getTime()) ? null : dateFormat.format(parsed);
	};

	class NetworkPanelsElement extends HTMLElement {
		#country = "";

		connectedCallback() {
			this.#country = this.dataset.country ?? "";

			// The groups are independent: one failing must not blank the others,
			// so each loads and reports on its own.
			void this.#loadAdoption();
			void this.#loadHealth();
			void this.#loadRouting();
			void this.#loadRankings();
		}

		/** A group endpoint, carrying the reader's country when the edge knew it. */
		#groupUrl(group: string): string {
			return this.#country
				? `/api/network/${group}?cc=${encodeURIComponent(this.#country)}`
				: `/api/network/${group}`;
		}

		/**
		 * Fetch one group into its panel, reporting failure in place.
		 *
		 * A renderer returning an empty string means "the group came back with
		 * nothing", which reads differently from a failure and is said so.
		 */
		async #loadGroup<T>(selector: string, url: string, render: (data: T) => string) {
			const target = this.querySelector<HTMLElement>(selector);
			if (!target) return;

			try {
				const response = await fetch(url);
				if (!response.ok) throw new Error(String(response.status));

				const markup = render((await response.json()) as T);
				if (markup) target.innerHTML = markup;
				else target.textContent = "Nothing reported right now.";
			} catch {
				target.textContent = "This data is unavailable right now. Reload to try again.";
			} finally {
				target.setAttribute("aria-busy", "false");
			}
		}

		#loadRouting() {
			return this.#loadGroup<RoutingSnapshot>(
				"[data-routing]",
				"/api/network/routing",
				(snapshot) =>
					renderDataTable(
						"Origin hijacks",
						["Prefix", "Detected ASN", "Expected ASN", "Confidence", "Started"],
						snapshot.events
							.filter((event) => event.kind === "hijack")
							.map((event) => [
								event.prefix,
								event.detectedOrigin,
								event.expectedOrigin,
								event.confidence,
								date(event.startDate),
							]),
					) +
					renderDataTable(
						"Route leaks",
						["Leaking ASN", "Path", "Prefixes", "Started", "Status"],
						snapshot.events
							.filter((event) => event.kind === "leak")
							.map((event) => [
								event.detectedOrigin,
								event.path?.join(" → "),
								event.prefixCount,
								date(event.startDate),
								event.finished == null ? null : event.finished ? "Ended" : "Ongoing",
							]),
					),
			);
		}

		#loadRankings() {
			return this.#loadGroup<RankingsSnapshot>(
				"[data-rankings]",
				this.#groupUrl("rankings"),
				(snapshot) =>
					[
						renderDataTable(
							snapshot.country ? `Popular · ${snapshot.country}` : "Popular",
							["Rank", "Domain"],
							snapshot.popular.map((entry) => [entry.rank, entry.domain]),
						),
						renderDataTable(
							"Trending",
							["Rank", "Domain"],
							snapshot.trending.map((entry) => [entry.rank, entry.domain]),
						),
						renderDataTable(
							"DDoS L3/4 by protocol",
							["Protocol", "Share"],
							snapshot.ddosLayer3.map((entry) => [entry.label, `${entry.percentage.toFixed(1)}%`]),
						),
						renderDataTable(
							"DDoS L7 by mitigation",
							["Mitigation", "Share"],
							snapshot.ddosLayer7.map((entry) => [entry.label, `${entry.percentage.toFixed(1)}%`]),
						),
					].join(""),
			);
		}

		#loadAdoption() {
			return this.#loadGroup<AdoptionSnapshot>(
				"[data-adoption]",
				this.#groupUrl("adoption"),
				(snapshot) => {
					const percent = (value: number | null) =>
						value === null ? null : `${value.toFixed(1)}%`;
					return renderDataTable(
						"HTTP traffic share",
						["Metric", ...(snapshot.country ? [snapshot.country] : []), "World"],
						snapshot.metrics
							.filter((metric) => metric.local !== null || metric.global !== null)
							.map((metric) => [
								metric.label,
								...(snapshot.country ? [percent(metric.local)] : []),
								percent(metric.global),
							]),
					);
				},
			);
		}

		#loadHealth() {
			return this.#loadGroup<HealthSnapshot>("[data-health]", "/api/network/health", (snapshot) =>
				[
					{ title: "Verified outages", events: snapshot.outages },
					{ title: "Traffic anomalies · unconfirmed", events: snapshot.anomalies },
				]
					.map((section) =>
						renderDataTable(
							section.title,
							["Location", "ASN", "Cause", "Scope", "Started", "Ended"],
							section.events.map((event) => [
								event.locations.join(", "),
								event.asns.join(", "),
								event.cause,
								event.scope,
								date(event.startDate),
								event.endDate ? date(event.endDate) : "Ongoing",
							]),
						),
					)
					.join(""),
			);
		}
	}

	customElements.define("network-panels", NetworkPanelsElement);
</script>
