---
import CopyButton from "@/components/ui/CopyButton.astro";
import PageLayout from "@/layouts/Base.astro";
import { readConnection } from "@/lib/network/connection";
import { LOOKUP_HOST } from "@/lib/network/handler";
import { countryFlag, countryName } from "@/lib/network/render";

export const prerender = false;

// The connection panel is rendered server-side because it needs no upstream
// call: every field is already attached to this request. The Radar-backed
// groups below load afterwards, so a slow or throttled Radar never delays the
// part the reader came for. See docs/adr/0006.
const connection = readConnection(Astro.request);

const flag = countryFlag(connection.country);
const location = [connection.city, connection.region, countryName(connection.country)]
	.filter(Boolean)
	.join(", ");

// The address is the one thing a reader opens this page for, so it leads as the
// readout and takes its own supporting line — who and where. The panel below
// carries the rest of the handshake — how — with no field said twice.
const identity = [
	connection.ipVersion ? `IPv${connection.ipVersion}` : null,
	location ? `${flag ? `${flag} ` : ""}${location}` : null,
	connection.colo ? `via ${connection.colo}` : null,
]
	.filter(Boolean)
	.join(" · ");

const rows: { label: string; value: string | null }[] = [
	{ label: "Timezone", value: connection.timezone },
	{
		label: "ASN",
		value: connection.asn
			? `AS${connection.asn}${connection.asOrganization ? ` · ${connection.asOrganization}` : ""}`
			: null,
	},
	{ label: "Protocol", value: connection.httpProtocol },
	{ label: "TLS", value: connection.tlsVersion },
	{
		label: "RTT",
		value: connection.clientTcpRttMs === null ? null : `${connection.clientTcpRttMs} ms`,
	},
];

const presentRows = rows.filter(
	(row): row is { label: string; value: string } => row.value !== null,
);
const lookupHost = LOOKUP_HOST;
---

<PageLayout
	meta={{
		title: "Network",
		description: "Your connection as the edge sees it, and how the Internet around it looks.",
	}}
>
	<section class="tool-workbench space-y-5">
		<div class="tool-hero space-y-4">
			<p class="tool-kicker">
				<a href="/tools/" class="hover:underline">Tools</a> / Network
			</p>
			<h1 class="tool-title">Network</h1>
			<p class="tool-lede max-w-2xl">
				What the edge sees when you connect, what Radar knows about any address, and how the
				Internet around you is behaving.
			</p>
			<div class="tool-hero-readout">
				<p class="tool-field-label">Your Address</p>
				{
					connection.ip ? (
						<>
							<div class="mt-2 flex flex-wrap items-center gap-2">
								<p class="tool-readout" translate="no">
									{connection.ip}
								</p>
								<CopyButton value={connection.ip} label="IP address" size="lg" />
							</div>
							{identity && <p class="tool-note mt-2">{identity}</p>}
						</>
					) : (
						<p class="tool-lede mt-2">
							No edge data on this request — this page is being served outside Cloudflare.
						</p>
					)
				}
			</div>
			{
				presentRows.length > 0 && (
					<div class="border-t border-[var(--tool-line)] pt-4">
						<div class="mb-3 flex items-center justify-between gap-2">
							<p class="tool-field-label">Connection Detail</p>
							<p class="tool-source">This Request</p>
						</div>
						<dl class="tool-rows">
							{presentRows.map((row) => (
								<div class="tool-row">
									<dt>{row.label}</dt>
									<dd class="flex items-center justify-between gap-2" translate="no">
										<span class="min-w-0 truncate">{row.value}</span>
										<CopyButton value={row.value} label={row.label} />
									</dd>
								</div>
							))}
						</dl>
						<p class="tool-note mt-3">
							From this request alone — no lookup, nothing stored. Same data from a terminal:{" "}
							<code translate="no">curl {lookupHost}?detail=1</code>
						</p>
					</div>
				)
			}
		</div>

		<!--
			md:col-span-2 marks the panels whose content needs the full row: Look Up
			is a form, Routing and Rankings hold variable-length lists (Rankings also
			nests its own sm:grid-cols-2). Adoption and Health are the only pair of
			similarly-shaped label/value comparisons, so they're the ones left at
			half width to sit side by side. A new panel defaults to half width —
			give it md:col-span-2 too unless it's a similarly compact comparison.
		-->
		<network-panels
			data-country={connection.country ?? ""}
			data-lookup-host={lookupHost}
			class="grid gap-5 md:grid-cols-2"
		>
			<div class="tool-panel md:col-span-2">
				<div class="tool-panel-head">
					<h2 class="tool-panel-title">Look Up an Address</h2>
					<p class="tool-source">Radar</p>
				</div>
				<p class="tool-note mt-1 mb-4">
					An address or a hostname. Country-level only — Radar does not geolocate finer.
				</p>
				<form data-lookup-form class="flex flex-wrap gap-2">
					<label class="sr-only" for="network-lookup">Address or hostname</label>
					<input
						id="network-lookup"
						name="q"
						type="text"
						autocomplete="off"
						autocapitalize="off"
						autocorrect="off"
						spellcheck="false"
						placeholder="1.1.1.1 or github.com…"
						class="tool-input min-w-0 flex-1"
					/>
					<button type="submit" class="tool-button" data-lookup-submit> Look Up </button>
				</form>
				<pre
					data-lookup-result
					aria-live="polite"
					class="tool-status mt-4 hidden overflow-x-auto p-3 text-xs">
				</pre>
			</div>

			<div class="tool-panel">
				<div class="tool-panel-head">
					<h2 class="tool-panel-title">
						{connection.country ? `${connection.country} vs. World` : "Adoption Worldwide"}
					</h2>
					<p class="tool-source">Radar · 7d</p>
				</div>
				<p class="tool-note mt-1 mb-4">
					Share of HTTP traffic Cloudflare saw over the last 7 days.
				</p>
				<div data-adoption aria-busy="true" class="text-sm">
					<span class="tool-lede">Loading…</span>
				</div>
			</div>

			<div class="tool-panel">
				<div class="tool-panel-head">
					<h2 class="tool-panel-title">Internet Health</h2>
					<p class="tool-source">Radar</p>
				</div>
				<p class="tool-note mt-1 mb-4">
					Verified outages are corroborated. Traffic anomalies are algorithmic and unconfirmed.
				</p>
				<div data-health aria-busy="true" class="text-sm">
					<span class="tool-lede">Loading…</span>
				</div>
			</div>

			<div class="tool-panel md:col-span-2">
				<div class="tool-panel-head">
					<h2 class="tool-panel-title">Routing</h2>
					<p class="tool-source">Radar</p>
				</div>
				<p class="tool-note mt-1 mb-4">Origin hijacks and route leaks Radar detected recently.</p>
				<div data-routing aria-busy="true" class="text-sm">
					<span class="tool-lede">Loading…</span>
				</div>
			</div>

			<div class="tool-panel md:col-span-2">
				<div class="tool-panel-head">
					<h2 class="tool-panel-title">Rankings &amp; Attacks</h2>
					<p class="tool-source">Radar</p>
				</div>
				<p class="tool-note mt-1 mb-4">
					Most popular and fastest-rising domains, and how attack traffic breaks down.
				</p>
				<div data-rankings aria-busy="true" class="text-sm">
					<span class="tool-lede">Loading…</span>
				</div>
			</div>
		</network-panels>
	</section>
</PageLayout>

<script>
	// The group readers define these shapes; importing them means a field added
	// or renamed there is a type error here rather than a silently blank panel.
	// `import type` is erased at build, so this pulls no server code client-side.
	import type {
		AdoptionSnapshot,
		AttackShare,
		HealthSnapshot,
		OutageEvent,
		RankedDomain,
		RankingsSnapshot,
		RoutingSnapshot,
	} from "@/lib/network/datasets";
	import { escapeHtml } from "@/utils/html";

	// The reader's own locale decides how these dates read, so the format is
	// resolved once here rather than hardcoded at each call site.
	const dateFormat = new Intl.DateTimeFormat(undefined, {
		day: "numeric",
		month: "short",
		year: "numeric",
	});

	class NetworkPanelsElement extends HTMLElement {
		#country = "";
		#lookupHost = "";

		connectedCallback() {
			this.#country = this.dataset.country ?? "";
			this.#lookupHost = this.dataset.lookupHost ?? "";

			this.#bindLookup();
			// The groups are independent: one failing must not blank the others,
			// so each loads and reports on its own.
			void this.#loadAdoption();
			void this.#loadHealth();
			void this.#loadRouting();
			void this.#loadRankings();
		}

		/** A group endpoint, carrying the reader's country when the edge knew it. */
		#groupUrl(group: string): string {
			return this.#country
				? `/api/network/${group}?cc=${encodeURIComponent(this.#country)}`
				: `/api/network/${group}`;
		}

		/**
		 * Fetch one group into its panel, reporting failure in place.
		 *
		 * A renderer returning an empty string means "the group came back with
		 * nothing", which reads differently from a failure and is said so.
		 */
		async #loadGroup<T>(selector: string, url: string, render: (data: T) => string) {
			const target = this.#el(selector);
			if (!target) return;

			try {
				const response = await fetch(url);
				if (!response.ok) throw new Error(String(response.status));

				const markup = render((await response.json()) as T);
				if (markup) target.innerHTML = markup;
				else target.textContent = "Nothing reported right now.";
			} catch {
				target.textContent = "This data is unavailable right now. Reload to try again.";
			} finally {
				target.setAttribute("aria-busy", "false");
			}
		}

		#loadRouting() {
			return this.#loadGroup<RoutingSnapshot>(
				"[data-routing]",
				"/api/network/routing",
				(snapshot) => {
					if (snapshot.events.length === 0) return "";

					return `<ul class="space-y-2">${snapshot.events
						.map((event) => {
							const label = event.kind === "hijack" ? "Hijack" : "Leak";
							const origins = [
								event.detectedOrigin ? `saw ${escapeHtml(event.detectedOrigin)}` : null,
								event.expectedOrigin ? `expected ${escapeHtml(event.expectedOrigin)}` : null,
							]
								.filter(Boolean)
								.join(", ");
							const confidence = event.confidence
								? ` · confidence ${escapeHtml(event.confidence)}`
								: "";

							return `<li class="text-sm">
								<span class="text-[var(--tool-ink)]">${label}</span>
								${event.prefix ? `<span class="tabular-nums" translate="no"> ${escapeHtml(event.prefix)}</span>` : ""}
								<div class="tool-note">${origins}${confidence}</div>
							</li>`;
						})
						.join("")}</ul>`;
				},
			);
		}

		#loadRankings() {
			return this.#loadGroup<RankingsSnapshot>(
				"[data-rankings]",
				this.#groupUrl("rankings"),
				(snapshot) => {
					const domainList = (title: string, domains: RankedDomain[]) =>
						domains.length === 0
							? ""
							: `<div>
							<p class="tool-field-label mb-2">${title}</p>
							<ol class="space-y-1 text-sm">${domains
								.map(
									(entry) =>
										`<li class="flex gap-2"><span class="w-5 shrink-0 text-right tabular-nums text-[var(--tool-muted)]">${entry.rank}</span><span class="min-w-0 truncate" translate="no">${escapeHtml(entry.domain)}</span></li>`,
								)
								.join("")}</ol>
						</div>`;

					const shareList = (title: string, shares: AttackShare[]) =>
						shares.length === 0
							? ""
							: `<div>
							<p class="tool-field-label mb-2">${title}</p>
							<ul class="space-y-1 text-sm">${shares
								.map(
									(share) =>
										`<li class="flex justify-between gap-2"><span class="min-w-0 truncate">${escapeHtml(share.label)}</span><span class="shrink-0 tabular-nums text-[var(--tool-muted)]">${share.percentage.toFixed(1)}%</span></li>`,
								)
								.join("")}</ul>
						</div>`;

					const sections = [
						domainList(
							snapshot.country ? `Popular · ${snapshot.country}` : "Popular",
							snapshot.popular,
						),
						domainList("Trending", snapshot.trending),
						shareList("DDoS L3/4 by protocol", snapshot.ddosLayer3),
						shareList("DDoS L7 by mitigation", snapshot.ddosLayer7),
					].filter(Boolean);

					return sections.length === 0
						? ""
						: `<div class="grid gap-6 sm:grid-cols-2">${sections.join("")}</div>`;
				},
			);
		}

		#el<T extends HTMLElement>(selector: string): T | null {
			return this.querySelector<T>(selector);
		}

		#bindLookup() {
			const form = this.#el<HTMLFormElement>("[data-lookup-form]");
			const output = this.#el<HTMLPreElement>("[data-lookup-result]");
			const input = this.#el<HTMLInputElement>("#network-lookup");
			if (!form || !output || !input) return;

			// A ?q= lands here from the lookup host, which redirects browsers
			// rather than serving them plain text.
			const initial = new URLSearchParams(window.location.search).get("q");
			if (initial) {
				input.value = initial;
				void this.#lookup(initial, output);
			}

			form.addEventListener("submit", (event) => {
				event.preventDefault();
				const query = input.value.trim();
				if (!query) return;

				// A result is worth linking to, so the address it describes lives in
				// the URL — the same ?q= this page already reads on load.
				const url = new URL(window.location.href);
				url.searchParams.set("q", query);
				window.history.replaceState(null, "", url);

				void this.#lookup(query, output);
			});
		}

		async #lookup(query: string, output: HTMLPreElement) {
			const submit = this.#el<HTMLButtonElement>("[data-lookup-submit]");
			// Both button states are written outright: reading the current label to
			// restore it later goes wrong the moment the ?q= autoload is still in
			// flight when the reader submits, which would pin it to "Looking Up…".
			const setBusy = (busy: boolean) => {
				if (!submit) return;
				submit.disabled = busy;
				submit.textContent = busy ? "Looking Up…" : "Look Up";
			};

			output.classList.remove("hidden");
			output.textContent = "Looking up…";
			setBusy(true);

			try {
				const response = await fetch(
					`https://${this.#lookupHost}/${encodeURIComponent(query)}?detail=1`,
					{ headers: { Accept: "text/plain" } },
				);
				output.textContent = (await response.text()).trimEnd() || "No result.";
			} catch {
				output.textContent = "Lookup failed. Check the address and try again.";
			} finally {
				setBusy(false);
			}
		}

		#loadAdoption() {
			return this.#loadGroup<AdoptionSnapshot>(
				"[data-adoption]",
				this.#groupUrl("adoption"),
				(snapshot) => {
					const rows = snapshot.metrics.filter(
						(metric) => metric.local !== null || metric.global !== null,
					);
					if (rows.length === 0) return "";

					const percent = (value: number | null) => (value === null ? "—" : `${value.toFixed(1)}%`);

					return `
					<table class="w-full text-sm">
						<caption class="sr-only">Share of HTTP traffic by protocol and standard</caption>
						<thead>
							<tr class="tool-field-label">
								<th class="py-1 text-left font-normal"><span class="sr-only">Metric</span></th>
								${snapshot.country ? `<th class="py-1 text-right font-normal" scope="col">${snapshot.country}</th>` : ""}
								<th class="py-1 text-right font-normal" scope="col">World</th>
							</tr>
						</thead>
						<tbody>
							${rows
								.map(
									(metric) => `
								<tr class="border-t border-[var(--tool-line)]">
									<th class="py-2 text-left font-normal text-[var(--tool-ink)]" scope="row">${metric.label}</th>
									${snapshot.country ? `<td class="py-2 text-right tabular-nums">${percent(metric.local)}</td>` : ""}
									<td class="py-2 text-right tabular-nums text-[var(--tool-muted)]">${percent(metric.global)}</td>
								</tr>`,
								)
								.join("")}
						</tbody>
					</table>`;
				},
			);
		}

		#loadHealth() {
			return this.#loadGroup<HealthSnapshot>("[data-health]", "/api/network/health", (snapshot) => {
				const sections = [
					{ title: "Verified outages", events: snapshot.outages },
					{ title: "Traffic anomalies · unconfirmed", events: snapshot.anomalies },
				].filter((section) => section.events.length > 0);

				return sections
					.map(
						(section) => `
					<div class="mb-4 last:mb-0">
						<p class="tool-field-label mb-2">${section.title}</p>
						<ul class="space-y-2">
							${section.events.map((event) => this.#renderEvent(event)).join("")}
						</ul>
					</div>`,
					)
					.join("");
			});
		}

		#renderEvent(event: OutageEvent): string {
			const where =
				[...event.locations, ...event.asns].map(escapeHtml).join(" · ") || "Unspecified";
			const detail = [event.cause, event.scope]
				.filter(Boolean)
				.map(String)
				.map(escapeHtml)
				.join(" · ");
			const stamp = (value: string) =>
				`<time datetime="${escapeHtml(value)}">${dateFormat.format(new Date(value))}</time>`;
			const start = event.startDate ? stamp(event.startDate) : null;
			const end = event.endDate ? stamp(event.endDate) : "ongoing";
			const when = start ? `${start} → ${end}` : "";

			return `
				<li class="text-sm">
					<span class="text-[var(--tool-ink)]">${where}</span>
					${detail ? `<span class="text-[var(--tool-muted)]"> · ${detail}</span>` : ""}
					${when ? `<div class="tool-note">${when}</div>` : ""}
				</li>`;
		}
	}

	customElements.define("network-panels", NetworkPanelsElement);
</script>
