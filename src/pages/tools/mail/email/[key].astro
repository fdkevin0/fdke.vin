---
import CodePanel from "@/components/ui/CodePanel.astro";
import Layout from "@/layouts/Base.astro";
import { getEmailContent } from "@/lib/api/email";

export const prerender = false;

const { key } = Astro.params;
const content = key ? await getEmailContent(key) : null;
if (!content) Astro.response.status = 404;
---

<Layout
	meta={{
		title: "View Email",
		description: "View email content",
	}}
>
	<section class="tool-workbench space-y-8">
		<div class="space-y-4">
			<p class="tool-kicker">
				<a href="/tools/" class="cactus-link">Tools</a> /
				<a href="/tools/mail/" class="cactus-link">Email</a> / Message
			</p>
			<h1 class="title">Email Details</h1>
			<a class="cactus-link" href="/tools/mail/">← Back to Email List</a>
		</div>

		<div class="tool-panel">
			{
				content ? (
					<CodePanel
						title={key || "Email"}
						code={content}
						copyValue={content}
						copyLabel="Copy"
						lang="plaintext"
					/>
				) : (
					<div class="tool-status tool-status--danger p-4 text-sm" role="alert">
						Email not found.
					</div>
				)
			}
		</div>
	</section>
</Layout>
