---
import Layout from "@/layouts/Base.astro";
import { listEmails } from "@/lib/api/email";

export const prerender = false;

const user = Astro.locals.user;

let emails: Awaited<ReturnType<typeof listEmails>> = [];
let error: string | null = null;
try {
	emails = await listEmails();
} catch (cause) {
	console.error("Error fetching emails:", cause);
	error = cause instanceof Error ? cause.message : "Failed to fetch emails";
}

function formatFileSize(bytes: number): string {
	if (bytes === 0) return "0 Bytes";
	const units = ["Bytes", "KB", "MB", "GB"];
	const unit = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
	return `${Number((bytes / 1024 ** unit).toFixed(2))} ${units[unit]}`;
}
---

<Layout
	meta={{
		title: "Email",
		description: "Read routed messages.",
	}}
>
	<section class="tool-workbench space-y-8">
		<div class="space-y-4">
			<p class="tool-kicker">
				<a href="/tools/" class="cactus-link">Tools</a> / Email
			</p>
			<div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
				<h1 class="title">Email</h1>
				{
					user && (
						<div class="tool-status px-3 py-2 text-sm">
							Logged in as <span class="text-global-text font-medium">{user.email}</span>
						</div>
					)
				}
			</div>
		</div>

		<div class="tool-panel">
			{
				error ? (
					<div class="tool-status tool-status--danger p-4 text-center text-sm" role="alert">
						{error}
					</div>
				) : (
					<div class="overflow-x-auto rounded-lg border border-[var(--tool-line)]">
						<table class="min-w-full border-collapse">
							<thead class="bg-[color-mix(in_oklab,var(--color-global-bg)_86%,var(--tool-line))]">
								<tr>
									{["Name", "Size", "Uploaded", "Type", "From", "To", "Subject"].map((label) => (
										<th class="px-4 py-3 text-left text-sm font-medium text-[var(--tool-muted)] md:px-6">
											{label}
										</th>
									))}
								</tr>
							</thead>
							<tbody>
								{emails.length === 0 ? (
									<tr>
										<td
											colspan="7"
											class="px-4 py-8 text-center text-sm text-[var(--tool-muted)] md:px-6"
										>
											No emails.
										</td>
									</tr>
								) : (
									emails.map((email) => (
										<tr class="border-b border-[var(--tool-line)] last:border-0 hover:bg-[color-mix(in_oklab,var(--color-global-bg)_82%,var(--tool-line))]">
											<td class="px-4 py-4 align-top text-sm md:px-6">
												<a
													href={`/tools/mail/email/${encodeURIComponent(email.key)}`}
													class="text-global-text font-medium break-words hover:underline"
												>
													{email.metadata.name || email.key}
												</a>
											</td>
											<td class="px-4 py-4 align-top text-sm text-[var(--tool-muted)] tabular-nums md:px-6">
												{formatFileSize(email.size)}
											</td>
											<td class="px-4 py-4 align-top text-sm text-[var(--tool-muted)] tabular-nums md:px-6">
												{email.date === "Unknown"
													? "Unknown"
													: new Date(email.date).toLocaleString()}
											</td>
											<td class="px-4 py-4 align-top text-sm text-[var(--tool-muted)] md:px-6">
												{email.metadata.type || "unknown"}
											</td>
											<td class="px-4 py-4 align-top text-sm break-words text-[var(--tool-muted)] md:px-6">
												{email.metadata.from || "Unknown"}
											</td>
											<td class="px-4 py-4 align-top text-sm break-words text-[var(--tool-muted)] md:px-6">
												{email.metadata.to || "Unknown"}
											</td>
											<td class="px-4 py-4 align-top text-sm break-words text-[var(--tool-muted)] md:px-6">
												{email.metadata.subject || "Untitled"}
											</td>
										</tr>
									))
								)}
							</tbody>
						</table>
					</div>
				)
			}
		</div>
	</section>
</Layout>
