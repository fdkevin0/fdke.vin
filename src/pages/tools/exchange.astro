---
import PageLayout from "@/layouts/Base.astro";
---

<PageLayout meta={{ title: "Exchange Rates" }}>
	<section class="tool-workbench space-y-8">
		<div class="space-y-4">
			<p class="tool-kicker">
				<a href="/tools/" class="cactus-link">Tools</a> / Exchange
			</p>
			<h1 class="title">Exchange rates</h1>
			<p class="tool-lede max-w-2xl">Latest 12 quotes from Bank of China.</p>
		</div>
		<div class="tool-panel overflow-hidden p-0" data-exchange-rates>
			<div class="py-4">
				<div class="flex flex-wrap items-center gap-3 text-xs font-semibold">
					<label class="flex items-center gap-2">
						<span>Currency</span>
						<select class="tool-select min-w-24 font-semibold" autocomplete="off" data-currency>
							<option value="USD">USD</option>
						</select>
					</label>
					<button class="tool-button" data-refresh type="button">Refresh</button>
				</div>
				<p class="tool-note mt-4">
					Mid change: <span class="text-global-text font-semibold" data-change>—</span>
					<span data-compare></span>
				</p>
			</div>
			<div class="space-y-3 pb-4">
				<div class="tool-status px-3 py-2 text-sm" data-status aria-live="polite" role="status">
					Loading…
				</div>
				<div class="overflow-x-auto rounded-lg border border-[var(--tool-line)]">
					<table class="min-w-full divide-y divide-[var(--tool-line)]">
						<thead
							class="bg-[color-mix(in_oklab,var(--color-global-bg)_86%,var(--tool-line))] text-xs text-[var(--tool-muted)]"
						>
							<tr>
								<th class="px-4 py-3 text-left font-semibold">Time</th>
								<th class="px-4 py-3 text-right font-semibold">Buy (Spot)</th>
								<th class="px-4 py-3 text-right font-semibold">Buy (Cash)</th>
								<th class="px-4 py-3 text-right font-semibold">Sell (Spot)</th>
								<th class="px-4 py-3 text-right font-semibold">Sell (Cash)</th>
								<th class="px-4 py-3 text-right font-semibold">Mid</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-[var(--tool-line)] text-sm" data-rates></tbody>
					</table>
				</div>
			</div>
		</div>
	</section>
</PageLayout>

<script>
	import type { BocRateRow } from "@/lib/api/exchange/boc";

	const root = document.querySelector("[data-exchange-rates]");
	if (root instanceof HTMLElement) {
		const currency = root.querySelector("[data-currency]") as unknown as HTMLSelectElement;
		const refresh = root.querySelector("[data-refresh]") as HTMLButtonElement;
		const status = root.querySelector("[data-status]") as HTMLElement;
		const rates = root.querySelector("[data-rates]") as HTMLTableSectionElement;
		const format = new Intl.NumberFormat("en-US", {
			minimumFractionDigits: 2,
			maximumFractionDigits: 2,
		});
		const display = (value: number | null) => (value == null ? "--" : format.format(value));
		const setStatus = (message: string, error = false) => {
			status.textContent = message;
			status.classList.toggle("tool-status--danger", error);
		};

		const render = (rows: BocRateRow[], code: string) => {
			rates.replaceChildren();
			for (const [index, row] of rows.entries()) {
				const tr = document.createElement("tr");
				tr.className = index === 0 ? "bg-accent/5 dark:bg-accent/10" : "even:bg-global-text/5";
				for (const [value, className] of [
					[row.pubTime, "text-left font-semibold"],
					[display(row.buyingRate), "text-right"],
					[display(row.cashBuyingRate), "text-right"],
					[display(row.sellingRate), "text-right"],
					[display(row.cashSellingRate), "text-right"],
					[display(row.middleRate), "text-right font-semibold"],
				] as const) {
					const td = document.createElement("td");
					td.className = `px-4 py-3 tabular-nums ${className}`;
					td.textContent = value;
					tr.appendChild(td);
				}
				rates.appendChild(tr);
			}

			const [latest, previous] = rows;
			const delta =
				latest?.middleRate != null && previous?.middleRate != null
					? latest.middleRate - previous.middleRate
					: null;
			(root.querySelector("[data-change]") as HTMLElement).textContent =
				delta == null
					? "--"
					: `${delta === 0 ? "Flat" : delta > 0 ? "Up" : "Down"} ${Math.abs(delta).toFixed(2)}`;
			(root.querySelector("[data-compare]") as HTMLElement).textContent = previous
				? `· vs ${previous.pubTime}`
				: "";
			setStatus(rows.length ? `${code} · ${rows.length} latest quotes` : `${code} · No data.`);
		};

		const loadRates = async () => {
			const code = currency.value;
			setStatus(`Fetching latest ${code} rates…`);
			refresh.disabled = true;
			try {
				const response = await fetch(
					`/api/exchange/rates?currency=${encodeURIComponent(code)}&limit=12`,
				);
				if (!response.ok) throw new Error(response.statusText);
				render((await response.json()) as BocRateRow[], code);
				localStorage.setItem("exchange:currency", code);
			} catch {
				setStatus("Failed to fetch rates. Please try again.", true);
			} finally {
				refresh.disabled = false;
			}
		};

		fetch("/api/exchange/currencies")
			.then((response) => (response.ok ? (response.json() as Promise<string[]>) : Promise.reject()))
			.then((codes) => {
				const selected = localStorage.getItem("exchange:currency") ?? "USD";
				currency.replaceChildren(
					...codes.map((code) => new Option(code, code, false, code === selected)),
				);
			})
			.catch(() => setStatus("Unable to load currencies. Using USD.", true))
			.finally(loadRates);
		currency.addEventListener("change", loadRates);
		refresh.addEventListener("click", loadRates);
	}
</script>
