---
import FediverseBlock from "@/components/note/FediverseBlock.astro";
import Note from "@/components/note/Note.astro";
import NoteInteractions from "@/components/note/NoteInteractions.astro";
import NotesListing from "@/components/note/NotesListing.astro";
import PageLayout from "@/layouts/Base.astro";
import {
	countInteractionsForNote,
	interactionCountsForNotes,
	listRepliesForNote,
} from "@/lib/ap/interactions";
import { renderNoteMarkdown } from "@/lib/ap/markdown";
import { getApEnv } from "@/lib/ap/runtime";
import { countNotes, getNoteById, listNoteAttachments, listNotesPage } from "@/lib/ap/storage";
import type {
	Interaction,
	InteractionCounts,
	NoteAttachment,
	Note as NoteType,
} from "@/lib/ap/types";
import type { SiteMeta } from "@/types";

export const prerender = false;

const slugParam = Astro.params.slug;
const isListing = slugParam === undefined || /^\d+$/.test(slugParam ?? "");

const env = await getApEnv();

type ListingData = {
	items: { note: NoteType; html: string; counts: InteractionCounts }[];
	meta: SiteMeta;
	page: number;
	totalPages: number;
	type: "listing";
};
type DetailData = {
	html: string;
	meta: SiteMeta;
	note: NoteType;
	attachments: NoteAttachment[];
	replies: Interaction[];
	counts: InteractionCounts;
	type: "detail";
};

let page: ListingData | DetailData;

if (isListing) {
	const MAX_NOTES_PER_PAGE = 10;
	const pageNumber = slugParam ? Number.parseInt(slugParam, 10) : 1;
	const total = await countNotes(env);
	const totalPages = Math.max(1, Math.ceil(total / MAX_NOTES_PER_PAGE));

	if (pageNumber < 1 || pageNumber > totalPages) {
		return Astro.rewrite("/404");
	}

	const offset = (pageNumber - 1) * MAX_NOTES_PER_PAGE;
	const notes = await listNotesPage(env, { limit: MAX_NOTES_PER_PAGE, offset });
	const counts = await interactionCountsForNotes(
		env,
		notes.map((note) => note.id),
	);
	const emptyCounts: InteractionCounts = { replies: 0, likes: 0, announces: 0 };
	const items = await Promise.all(
		notes.map(async (note) => ({
			note,
			html: await renderNoteMarkdown(note.content),
			counts: counts.get(note.id) ?? emptyCounts,
		})),
	);
	page = {
		items,
		meta: { description: "Read my collection of notes", title: "Notes" },
		page: pageNumber,
		totalPages,
		type: "listing",
	};
} else {
	const note = await getNoteById(env, slugParam as string);

	if (!note) {
		return Astro.rewrite("/404");
	}

	const attachments = await listNoteAttachments(env, note.id);

	const [html, replies, counts] = await Promise.all([
		renderNoteMarkdown(note.content),
		listRepliesForNote(env, note.id),
		countInteractionsForNote(env, note.id),
	]);
	page = {
		html,
		meta: {
			description:
				note.summary || `Read my note posted on: ${note.publishDate.toLocaleDateString()}`,
			title: note.title ?? "Note",
		},
		note,
		attachments,
		replies,
		counts,
		type: "detail",
	};
}

const meta = page.meta;
---

{
	page.type === "listing" ? (
		<PageLayout meta={meta}>
			<NotesListing items={page.items} page={page.page} totalPages={page.totalPages} />
		</PageLayout>
	) : (
		<PageLayout meta={meta}>
			<Note as="h1" note={page.note} html={page.html} attachments={page.attachments} />
			<FediverseBlock note={page.note} />
			<NoteInteractions counts={page.counts} replies={page.replies} />
		</PageLayout>
	)
}
