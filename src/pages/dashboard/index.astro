---
import Layout from "@/layouts/Base.astro";

export const prerender = false;

const user = Astro.locals.user;
---

<Layout
	meta={{
		title: "Dashboard",
		description: "Private dashboard for managing feed operations and internal API access.",
	}}
>
	<section class="space-y-8">
		<h1 class="title">Dashboard</h1>
		{user && <p class="text-global-text/75">Signed in as {user.email}</p>}
		<ul class="space-y-4" role="list">
			<li><a class="cactus-link" href="/dashboard/feed">Feed management</a></li>
			<li><a class="cactus-link" href="/dashboard/notes">Notes &amp; federation</a></li>
			<li><a class="cactus-link" href="/dashboard/api-management">API management</a></li>
		</ul>
	</section>
</Layout>
