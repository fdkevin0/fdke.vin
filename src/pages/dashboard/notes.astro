---
import Layout from "@/layouts/Base.astro";
import { addBlockedDomain, listBlockedDomains, removeBlockedDomain } from "@/lib/ap/blocklist";
import { sendNoteActivity } from "@/lib/ap/federation";
import { countFollowers } from "@/lib/ap/followers";
import {
	deleteInteraction,
	deleteInteractionsForNote,
	interactionCountsForNotes,
	listInteractionsForNote,
	setInteractionHidden,
} from "@/lib/ap/interactions";
import { getApEnv } from "@/lib/ap/runtime";
import { deleteNote, listNotes } from "@/lib/ap/storage";

export const prerender = false;

const env = await getApEnv();

async function applyAction(form: FormData): Promise<string> {
	const action = String(form.get("action") ?? "");
	const id = String(form.get("id") ?? "").trim();

	if (action === "block") {
		const domain = await addBlockedDomain(env, {
			domain: String(form.get("domain") ?? ""),
			reason: String(form.get("reason") ?? "").trim() || null,
		});
		return domain ? `Blocked ${domain}` : "Invalid domain";
	}
	if (action === "unblock") {
		await removeBlockedDomain(env, String(form.get("domain") ?? ""));
		return "Domain unblocked";
	}
	if (action === "delete-note" && id) {
		if (await deleteNote(env, id)) {
			await deleteInteractionsForNote(env, id);
			await sendNoteActivity(env, "Delete", id);
		}
		return "Note deleted; tombstone queued";
	}
	if ((action === "hide" || action === "show") && id) {
		await setInteractionHidden(env, id, action === "hide");
		return action === "hide" ? "Reply hidden" : "Reply shown";
	}
	if (action === "delete-interaction" && id) {
		await deleteInteraction(env, id);
		return "Reply removed";
	}
	return "Updated";
}

if (Astro.request.method === "POST") {
	Astro.response.status = 303;
	Astro.response.headers.set(
		"Location",
		`/dashboard/notes?message=${encodeURIComponent(await applyAction(await Astro.request.formData()))}`,
	);
}

const notes = await listNotes(env);
const [followerCount, blocklist, counts, interactions] = await Promise.all([
	countFollowers(env),
	listBlockedDomains(env),
	interactionCountsForNotes(
		env,
		notes.map((note) => note.id),
	),
	Promise.all(notes.map((note) => listInteractionsForNote(env, note.id))),
]);
const message = Astro.url.searchParams.get("message");
---

<Layout
	meta={{
		title: "Dashboard Notes",
		description: "Moderate federated Notes, replies, and blocked domains.",
	}}
>
	<section class="space-y-6">
		<div class="space-y-2">
			<p class="text-[11px] tracking-[0.42em] text-zinc-500 uppercase dark:text-zinc-400">
				<a href="/dashboard" class="hover:underline">Dashboard</a> / Notes
			</p>
			<h1 class="title text-2xl">Dashboard Notes</h1>
			<p class="text-sm text-zinc-600 dark:text-zinc-300">
				{notes.length} notes · {followerCount} followers
			</p>
		</div>

		{
			message && (
				<p
					role="status"
					class="rounded border border-emerald-300 bg-emerald-50 px-3 py-2 text-sm text-emerald-800 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-300"
				>
					{message}
				</p>
			)
		}

		<section class="space-y-3 rounded border border-zinc-200 p-4 md:p-5 dark:border-zinc-800">
			<h2 class="text-lg font-semibold">Notes</h2>
			{notes.length === 0 && <p class="text-sm text-zinc-500">No notes yet.</p>}
			{
				notes.map((note, index) => {
					const noteCounts = counts.get(note.id) ?? { replies: 0, likes: 0, announces: 0 };
					const replies = interactions[index]?.filter((item) => item.kind === "reply") ?? [];
					return (
						<details class="rounded border border-zinc-200 dark:border-zinc-800">
							<summary class="cursor-pointer p-4">
								<a href={`/notes/${note.id}/`} class="font-semibold underline underline-offset-4">
									{note.title ?? (note.content.slice(0, 72) || `Note ${note.id}`)}
								</a>
								<span class="ml-3 text-xs text-zinc-500">
									{note.source} · 💬 {noteCounts.replies} · ❤️ {noteCounts.likes} · 🔁{" "}
									{noteCounts.announces}
								</span>
							</summary>
							<div class="space-y-4 border-t border-zinc-200 p-4 dark:border-zinc-800">
								<form method="post">
									<input type="hidden" name="action" value="delete-note" />
									<input type="hidden" name="id" value={note.id} />
									<button class="rounded border border-red-300 px-3 py-2 text-xs text-red-700 uppercase dark:border-red-800 dark:text-red-300">
										Delete note
									</button>
								</form>
								<div class="space-y-2">
									{replies.length === 0 && <p class="text-sm text-zinc-500">No replies.</p>}
									{replies.map((reply) => (
										<div
											class:list={[
												"rounded border border-zinc-200 p-3 text-sm dark:border-zinc-800",
												{ "opacity-60": reply.hidden },
											]}
										>
											<p class="font-medium">
												{reply.actorName ?? reply.actorHandle ?? reply.actorId}
											</p>
											<div class="prose prose-sm prose-cactus my-2 max-w-none">
												<Fragment set:html={reply.content ?? ""} />
											</div>
											<div class="flex gap-2">
												<form method="post">
													<input
														type="hidden"
														name="action"
														value={reply.hidden ? "show" : "hide"}
													/>
													<input type="hidden" name="id" value={reply.id} />
													<button class="rounded border px-3 py-1 text-xs uppercase">
														{reply.hidden ? "Unhide" : "Hide"}
													</button>
												</form>
												<form method="post">
													<input type="hidden" name="action" value="delete-interaction" />
													<input type="hidden" name="id" value={reply.id} />
													<button class="rounded border border-red-300 px-3 py-1 text-xs text-red-700 uppercase">
														Remove
													</button>
												</form>
											</div>
										</div>
									))}
								</div>
							</div>
						</details>
					);
				})
			}
		</section>

		<section class="space-y-4 rounded border border-zinc-200 p-4 md:p-5 dark:border-zinc-800">
			<h2 class="text-lg font-semibold">Domain blocklist</h2>
			<form method="post" class="flex flex-wrap gap-2">
				<input type="hidden" name="action" value="block" />
				<input
					name="domain"
					required
					placeholder="spam.example"
					class="flex-1 rounded border bg-transparent px-3 py-2 text-sm"
				/>
				<input
					name="reason"
					placeholder="reason (optional)"
					class="flex-1 rounded border bg-transparent px-3 py-2 text-sm"
				/>
				<button
					class="rounded bg-zinc-900 px-4 py-2 text-sm text-white dark:bg-zinc-100 dark:text-zinc-900"
					>Block</button
				>
			</form>
			{blocklist.length === 0 && <p class="text-sm text-zinc-500">No blocked domains.</p>}
			{
				blocklist.map((entry) => (
					<form
						method="post"
						class="flex items-center justify-between gap-3 rounded border border-zinc-200 px-3 py-2 text-sm dark:border-zinc-800"
					>
						<input type="hidden" name="action" value="unblock" />
						<input type="hidden" name="domain" value={entry.domain} />
						<span>
							<strong>{entry.domain}</strong>
							{entry.reason && ` · ${entry.reason}`}
						</span>
						<button class="rounded border px-3 py-1 text-xs uppercase">Remove</button>
					</form>
				))
			}
		</section>
	</section>
</Layout>
